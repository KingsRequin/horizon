// Réglage tout ou rien : carte avec le libellé (et son explication) à gauche et un interrupteur
// à droite ; l'effet est immédiat. Toute la carte se clique ; clavier (Tab, Espace, Entrée) avec
// l'anneau de focus. Désactivée : estompée, rien ne réagit. `nested` : ligne du corps d'une carte
// dépliante. Contrôlée : elle annonce `toggled(nouvelle valeur)`.

import { Theme } from "../theme.slint";
import { FocusRing } from "../panel/focus.slint";
import { SettingsLayout } from "layout.slint";
import { Card } from "card.slint";
import { Switch } from "switch.slint";

export component SettingCheck inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> nested;
    out property <bool> keyboard;
    callback toggled(bool);
    property <length> text-w: Card.text-w(root.nested, 40px);

    VerticalLayout {
        padding-bottom: root.nested ? 0 : Card.gap;
        card := Rectangle {
            min-height: Card.min-h;
            border-radius: root.nested ? 0 : Theme.r-md;
            background: area.has-hover && root.enabled ? (root.nested ? Card.body-hover : Card.bg-hover) : (root.nested ? transparent : Card.bg);
            FocusScope {
                enabled: root.enabled;
                focus-on-click: false;
                focus-gained(r) => {
                    root.keyboard = r == FocusReason.tab-navigation;
                }
                focus-lost => {
                    root.keyboard = false;
                }
                key-pressed(e) => {
                    if e.text == " " || e.text == Key.Return {
                        root.toggled(!root.checked);
                        return accept;
                    }
                    reject
                }
            }
            area := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
                clicked => {
                    root.toggled(!root.checked);
                }
            }
            HorizontalLayout {
                padding-top: Card.pad-y;
                padding-bottom: Card.pad-y;
                padding-left: root.nested ? Card.indent : Card.pad-x;
                padding-right: Card.pad-x;
                spacing: Card.spacing;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    opacity: root.enabled ? 1 : Theme.o-off;
                    Text {
                        width: root.text-w;
                        text: root.label;
                        color: SettingsLayout.t.text;
                        wrap: word-wrap;
                    }
                    if root.hint != "": Text {
                        width: root.text-w;
                        text: root.hint;
                        color: SettingsLayout.t.text-dim;
                        font-size: Theme.fs-meta;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Switch {
                        checked: root.checked;
                        hovered: area.has-hover;
                        enabled: root.enabled;
                    }
                }
            }
            if root.nested: Rectangle {
                y: 0;
                height: 1px;
                background: Card.line;
            }
            if root.keyboard: FocusRing {
                width: card.width + 6px;
                height: card.height + 6px;
                radius: Theme.r-md;
            }
        }
    }
}
