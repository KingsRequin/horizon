// Ligne de réglage (app/src/settings/ui/Row.svelte) : carte `surface-1`, libellé (et
// explication) à gauche, contrôle posé en enfants à droite, centré verticalement. 6 px sous la
// carte. Les textes passent à la ligne dans la place que laisse le contrôle
// (`SettingsLayout.content-w`).

import { Theme } from "../theme.slint";
import { SettingsLayout } from "layout.slint";

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    // Place des textes : la largeur du contenu moins les marges, l'écart et le contrôle.
    property <length> text-w: max(60px, SettingsLayout.content-w - 20px - 14px - ctl.preferred-width);

    VerticalLayout {
        padding-bottom: 6px;
        Rectangle {
            border-radius: Theme.r-lg;
            background: SettingsLayout.t.surface-1;
            HorizontalLayout {
                padding-top: 9px;
                padding-bottom: 9px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        width: root.text-w;
                        text: root.label;
                        color: SettingsLayout.t.text;
                        wrap: word-wrap;
                    }
                    if root.hint != "": Text {
                        width: root.text-w;
                        text: root.hint;
                        color: SettingsLayout.t.text-dim;
                        font-size: Theme.fs-meta;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ctl := HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        @children
                    }
                }
            }
        }
    }
}
