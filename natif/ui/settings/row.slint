// Carte de réglage : libellé (et explication) à gauche, contrôle posé en enfants à droite,
// centré verticalement. `nested` : ligne du corps d'une carte dépliante (`SettingExpander`). Les
// textes passent à la ligne dans la place que laisse le contrôle (`SettingsLayout.content-w`).

import { Theme } from "../theme.slint";
import { SettingsLayout } from "layout.slint";
import { Card } from "card.slint";

export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> nested;
    in property <bool> enabled: true;
    property <length> text-w: Card.text-w(root.nested, ctl.preferred-width);

    VerticalLayout {
        padding-bottom: root.nested ? 0 : Card.gap;
        Rectangle {
            min-height: Card.min-h;
            border-radius: root.nested ? 0 : Theme.r-md;
            background: root.nested ? transparent : Card.bg;
            HorizontalLayout {
                padding-top: Card.pad-y;
                padding-bottom: Card.pad-y;
                padding-left: root.nested ? Card.indent : Card.pad-x;
                padding-right: Card.pad-x;
                spacing: Card.spacing;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    opacity: root.enabled ? 1 : Theme.o-off;
                    Text {
                        width: root.text-w;
                        text: root.label;
                        color: SettingsLayout.t.text;
                        wrap: word-wrap;
                    }
                    if root.hint != "": Text {
                        width: root.text-w;
                        text: root.hint;
                        color: SettingsLayout.t.text-dim;
                        font-size: Theme.fs-meta;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    ctl := HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        @children
                    }
                }
            }
            if root.nested: Rectangle {
                y: 0;
                height: 1px;
                background: Card.line;
            }
        }
    }
}
