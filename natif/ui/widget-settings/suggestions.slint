// Réglages Suggestions (app/src/widgets/suggestions/Settings.svelte) : éléments exclus par « Ne
// plus proposer », chacun retirable (de nouveau proposé à la fin du délai d'annulation).
// Service : src/ui/widget_settings/suggestions.rs.

import { Theme } from "../theme.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsSubheading, SettingsNote } from "../settings/text.slint";
import { RemoveButton } from "../settings/button.slint";

export struct BlockedRow {
    label: string,
    // « site » ou « application ».
    kind: string,
}

export global SuggestionsSettingsData {
    in property <[BlockedRow]> rows;
    in property <bool> loaded;
    in property <string> error;
    callback unblock(int);
}

export component SuggestionsSettings inherits VerticalLayout {
    alignment: start;
    SettingsSubheading {
        text: "Ne plus proposer";
    }
    if SuggestionsSettingsData.rows.length > 0: VerticalLayout {
        spacing: 6px;
        for r[i] in SuggestionsSettingsData.rows: Rectangle {
            border-radius: Theme.r-lg;
            background: SettingsLayout.t.surface-1;
            HorizontalLayout {
                padding-top: 5px;
                padding-bottom: 5px;
                padding-left: 10px;
                padding-right: 6px;
                spacing: 12px;
                Text {
                    text: r.label;
                    color: SettingsLayout.t.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: r.kind;
                    color: SettingsLayout.t.text-dim;
                    font-size: Theme.fs-meta;
                    vertical-alignment: center;
                }
                RemoveButton {
                    what: "« " + r.label + " » de la liste";
                    clicked => {
                        SuggestionsSettingsData.unblock(i);
                    }
                }
            }
        }
    }
    if SuggestionsSettingsData.loaded && SuggestionsSettingsData.rows.length == 0: SettingsNote {
        text: "Aucun élément exclu. Clic droit sur une suggestion → « Ne plus proposer ».";
        font-size: Theme.fs-body;
    }
    if SuggestionsSettingsData.error != "": SettingsNote {
        text: SuggestionsSettingsData.error;
        tint: SettingsLayout.t.bad;
        font-size: Theme.fs-body;
        above: 6px;
    }
}
