// Réglages Serveurs (app/src/widgets/servers/Settings.svelte) : hôtes de ~/.ssh/config
// (renommer, masquer, choisir le test) et hôtes ajoutés à la main (adresse, retrait annulable).
// Seuls les hôtes modifiés sont enregistrés. Service : src/ui/widget_settings/servers.rs.

import { Theme } from "../theme.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsSubheading, SettingsNote } from "../settings/text.slint";
import { SettingsButton, RemoveButton } from "../settings/button.slint";
import { SelectField } from "../settings/field.slint";
import { InputField } from "../settings/input.slint";
import { CheckMark } from "../panel/check.slint";
import { Tip } from "../tooltip.slint";

export struct ServerRow {
    // Réglage de l'hôte.
    label: string,
    address: string,
    hidden: bool,
    http: bool,
    port: string,
    url: string,
    manual: bool,
    // Hôte de ssh : « adresse:port » lu dans ~/.ssh/config.
    from: string,
    // Nom proposé (identifiant de ssh, ou « Nom affiché »).
    name-placeholder: string,
    port-placeholder: string,
    bad-port: bool,
    // Résultat du dernier « Tester » : vide, ou texte et état (0 en cours, 1 en ligne, 2 hors ligne).
    test: string,
    test-state: int,
    // « le serveur « X » » (infobulle de la corbeille).
    what: string,
}

export global ServersSettingsData {
    in property <[ServerRow]> rows;
    in property <bool> loaded;
    // Ligne, champ (`label`, `address`, `url`, `port`), texte.
    callback text(int, string, string);
    callback shown(int, bool);
    callback pick-check(int, length, length);
    callback test(int);
    callback add();
    callback remove(int);
}

component Line inherits HorizontalLayout {
    spacing: 8px;
}

export component ServersSettings inherits VerticalLayout {
    alignment: start;
    SettingsSubheading {
        text: "Serveurs";
    }
    if ServersSettingsData.loaded && ServersSettingsData.rows.length == 0: SettingsNote {
        text: "Aucun hôte dans ~/.ssh/config. Ajoute un serveur ci-dessous.";
        below: 8px;
    }
    VerticalLayout {
        padding-bottom: 10px;
        spacing: 6px;
        for r[i] in ServersSettingsData.rows: Rectangle {
            property <length> inner: SettingsLayout.content-w - 20px;
            border-radius: Theme.r-lg;
            background: SettingsLayout.t.surface-1;
            opacity: r.hidden ? Theme.o-stale : 1;
            animate opacity { duration: Theme.dur-fast; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 6px;
                Line {
                    Rectangle {
                        width: 13px;
                        CheckMark {
                            y: (parent.height - self.height) / 2;
                            checked: !r.hidden;
                            hovered: show.has-hover;
                        }
                        show := TouchArea {
                            mouse-cursor: pointer;
                            changed has-hover => {
                                if self.has-hover {
                                    Tip.show(r.hidden ? "Masqué" : "Affiché");
                                } else {
                                    Tip.hide();
                                }
                            }
                            clicked => {
                                ServersSettingsData.shown(i, r.hidden);
                            }
                        }
                    }
                    InputField {
                        horizontal-stretch: 1;
                        value: r.label;
                        placeholder: r.name-placeholder;
                        edited(t) => {
                            ServersSettingsData.text(i, "label", t);
                        }
                    }
                    if r.manual: InputField {
                        horizontal-stretch: 1.2;
                        mono: true;
                        value: r.address;
                        placeholder: "adresse (192.168.1.40, nas.lan)";
                        edited(t) => {
                            ServersSettingsData.text(i, "address", t);
                        }
                    }
                    if r.manual: VerticalLayout {
                        alignment: center;
                        RemoveButton {
                            what: r.what;
                            clicked => {
                                ServersSettingsData.remove(i);
                            }
                        }
                    }
                    if !r.manual && r.from != "": Text {
                        max-width: inner * 45%;
                        text: r.from;
                        color: SettingsLayout.t.text-dim;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-meta;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Line {
                    SelectField {
                        text: r.http ? "HTTP(S)" : "Port TCP";
                        open(x, y) => {
                            ServersSettingsData.pick-check(i, x, y);
                        }
                    }
                    if !r.http: InputField {
                        width: 64px;
                        mono: true;
                        value: r.port;
                        placeholder: r.port-placeholder;
                        invalid: r.bad-port;
                        committed(t) => {
                            ServersSettingsData.text(i, "port", t);
                        }
                    }
                    InputField {
                        horizontal-stretch: 1;
                        value: r.url;
                        placeholder: r.http ? "https://… (testée)" : "Interface web (facultatif)";
                        edited(t) => {
                            ServersSettingsData.text(i, "url", t);
                        }
                    }
                    SettingsButton {
                        text: "Tester";
                        enabled: r.test-state != 0 || r.test == "";
                        clicked => {
                            ServersSettingsData.test(i);
                        }
                    }
                }
                if r.bad-port: Text {
                    width: inner;
                    text: "Port invalide : un nombre entier de 1 à 65535 (vide = celui de ssh, sinon 22).";
                    color: SettingsLayout.t.bad;
                    font-size: Theme.fs-meta;
                    wrap: word-wrap;
                }
                if r.test != "": Text {
                    width: inner;
                    text: r.test;
                    color: r.test-state == 1 ? SettingsLayout.t.ok : (r.test-state == 2 ? SettingsLayout.t.bad : SettingsLayout.t.text-dim);
                    font-size: Theme.fs-meta;
                    wrap: word-wrap;
                }
            }
        }
    }
    HorizontalLayout {
        alignment: start;
        SettingsButton {
            text: "Ajouter un serveur";
            icon: @image-url("../../icons/phosphor/plus.svg");
            height: 28px;
            clicked => {
                ServersSettingsData.add();
            }
        }
    }
    SettingsNote {
        text: "Les hôtes viennent de ~/.ssh/config (blocs Host sans joker) ; seuls le nom, l’adresse et le port y sont lus. Test toutes les 60 s : connexion au port (22 par défaut, ou celui de ssh) ou réponse HTTP. Un serveur n’est dit hors ligne qu’après deux échecs de suite.";
        above: 14px;
        below: 6px;
    }
    SettingsNote {
        text: "« Terminal SSH » ouvre Windows Terminal (ssh <hôte>), avec les clés et réglages de ssh.";
    }
}
