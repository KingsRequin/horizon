// Panneau du quota Claude (app/src/widgets/claude_quota/Panel.svelte) : chaque limite (semaine,
// 5 h, modèles) avec sa remise à zéro et son rythme ; part d'un modèle dans la semaine ;
// répartition par usage ; crédits. L'ouverture redemande le quota (au plus une fois par minute).
// Textes faits par src/widgets/claude_quota/panel.rs.

import { Theme, StyleTokens } from "../../theme.slint";
import { Eyebrow, Track } from "../../gauge.slint";
import { PanelBase } from "../../panel/base.slint";
import { PanelHead } from "../../panel/head.slint";
import { Divider } from "../../panel/divider.slint";
import { EmptyState } from "../../panel/empty.slint";
import { ErrorLine } from "../../panel/error.slint";

// Une limite.
export struct ClaudeQuotaPanelLimit {
    // « Semaine · tous modèles », « Session de 5 h », nom du modèle.
    title: string,
    // Limite propre à un modèle (« · limite propre au modèle »).
    model: bool,
    // « 88 % » et part utilisée (0–1).
    pct: string,
    used: float,
    // Couleur (`quotaColor`) : 0 accent, 1 attention, 2 alerte.
    level: int,
    // « Remise à zéro jeu. 20 nov. à 10:00 · dans 2 j 23 h » ; vide : inconnue.
    reset: string,
    // Part d'un modèle dans la semaine générale ; vide : aucune.
    share: string,
    // Rythme (« 88 % utilisés pour 40 % du temps écoulé · plafond vers … ») ; vide : aucun.
    pace: string,
}

// Une ligne de la répartition de la semaine.
export struct ClaudeQuotaPanelShare {
    label: string,
    pct: string,
    value: float,
    zero: bool,
}

export global ClaudeQuotaPanelData {
    // « mis à jour il y a 2 min » ; vide : jamais reçu.
    in-out property <string> updated;
    in-out property <bool> has-quota;
    in-out property <[ClaudeQuotaPanelLimit]> limits;
    // La répartition a au moins une part non nulle.
    in-out property <bool> has-breakdown;
    in-out property <[ClaudeQuotaPanelShare]> breakdown;
    in-out property <string> extra;
    in-out property <string> error;
}

// Ligne secondaire qui passe à la ligne. Largeur donnée (celle du panneau : 326 px, ou la
// colonne d'une tuile) : la hauteur d'un texte
// à la ligne dans une liste (`for`) est mal mesurée tant que sa largeur vient de la mise en page
// (une ligne comptée au lieu de deux : le panneau était trop court, en-tête et pied tassés).
component Meta inherits Text {
    in property <StyleTokens> t;
    in property <length> panel-w: 326px;
    width: self.panel-w;
    color: t.text-dim;
    font-size: Theme.fs-meta;
    wrap: word-wrap;
}

// `max-height: 365px` + défilement de la version Tauri : pas de `PanelScroll` ici (textes à la
// ligne mal mesurés dans une vue qui défile) ; le panneau prend sa hauteur naturelle (bornée à
// l'écran), assez pour la semaine, la session de 5 h et deux modèles.
export component ClaudeQuotaPanel inherits PanelBase {
    width: 326px;
    spacing: 10px;


    PanelHead {
        t: root.t;
        title: "Quota Claude";
        if ClaudeQuotaPanelData.updated != "": Text {
            text: ClaudeQuotaPanelData.updated;
            color: root.t.text-dim;
            font-size: Theme.fs-meta;
            vertical-alignment: center;
        }
    }

    for w in ClaudeQuotaPanelData.limits: VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 8px;
            HorizontalLayout {
                horizontal-stretch: 1;
                Text {
                    text: w.title;
                    color: root.t.text;
                    font-size: root.t.fs-body;
                    font-weight: 600;
                    vertical-alignment: bottom;
                    overflow: elide;
                }
                if w.model: Text {
                    text: " · limite propre au modèle";
                    color: root.t.text-dim;
                    font-size: Theme.fs-meta;
                    vertical-alignment: bottom;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if !w.model: Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: w.pct;
                color: w.level == 2 ? root.t.bad : w.level == 1 ? root.t.warn : Theme.accent;
                font-family: Theme.font-mono;
                font-weight: 600;
                font-size: Theme.fs-title;
                vertical-alignment: bottom;
            }
        }
        Track {
            t: root.t;
            height: 5px;
            rounded: true;
            value: w.used;
            tint: w.level == 2 ? root.t.bad : w.level == 1 ? root.t.warn : Theme.accent;
        }
        if w.reset != "": Meta {
            t: root.t;
            panel-w: root.width;
            text: w.reset;
        }
        if w.share != "": Meta {
            t: root.t;
            panel-w: root.width;
            text: w.share;
        }
        if w.pace != "": Meta {
            t: root.t;
            panel-w: root.width;
            text: w.pace;
            color: root.t.text;
        }
    }

    if ClaudeQuotaPanelData.has-quota && ClaudeQuotaPanelData.has-breakdown: VerticalLayout {
        Divider {
            t: root.t;
        }
        VerticalLayout {
            padding-top: 8px;
            spacing: 5px;
            Eyebrow {
                t: root.t;
                label: "Répartition de la semaine";
                horizontal-alignment: left;
            }
            for r in ClaudeQuotaPanelData.breakdown: HorizontalLayout {
                spacing: 8px;
                opacity: r.zero ? Theme.o-off : 1;
                Text {
                    width: 92px;
                    text: r.label;
                    color: root.t.text;
                    font-size: Theme.fs-meta;
                    vertical-alignment: center;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Track {
                        t: root.t;
                        rounded: true;
                        value: r.value;
                    }
                }
                Text {
                    // `6ch` : six chasses de JetBrains Mono (0,6 em).
                    width: Theme.fs-meta * 0.6 * 6;
                    text: r.pct;
                    color: root.t.text-dim;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-meta;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
    }

    if ClaudeQuotaPanelData.has-quota: VerticalLayout {
        Divider {
            t: root.t;
        }
        VerticalLayout {
            padding-top: 8px;
            Meta {
                t: root.t;
                panel-w: root.width;
                text: ClaudeQuotaPanelData.extra;
            }
        }
    }

    if !ClaudeQuotaPanelData.has-quota && ClaudeQuotaPanelData.error == "": EmptyState {
        t: root.t;
        text: "Chargement…";
    }
    if ClaudeQuotaPanelData.error != "": ErrorLine {
        t: root.t;
        text: ClaudeQuotaPanelData.error;
    }
}
