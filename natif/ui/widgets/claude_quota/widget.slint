// Quota de l'abonnement Claude (app/src/widgets/claude_quota/Widget.svelte) : jauges des
// limites générales (et d'un modèle proche de son plafond) ; barre large : la prochaine remise à
// zéro à côté (pas sur une barre resserrée). Données périmées : estompées, avec un petit cercle.
// Lecture impossible : « — » et ⚠ au lieu de disparaître. Survol = panneau du quota.

import { Theme, StyleTokens } from "../../theme.slint";
import { Icon } from "../../components.slint";
import { WidgetFrame } from "../../widget-frame.slint";
import { Gauge } from "../../gauge.slint";

// Une limite montrée dans la barre. `level` : 0 accent, 1 attention, 2 alerte (`quotaColor`).
export struct QuotaGaugeRow {
    label: string,
    value: float,
    level: int,
}

export global ClaudeQuotaData {
    // Quota lu au moins une fois, ou erreur connue (sinon le widget ne montre rien).
    in property <bool> known;
    // Aucune réponse : « — » et ⚠.
    in property <bool> failed;
    // Dernière lecture en échec, valeurs d'avant.
    in property <bool> stale;
    in property <[QuotaGaugeRow]> gauges;
    // Cause de l'échec (infobulle « Quota Claude illisible : … »).
    in property <string> error;
    // « remise à zéro dans 4 j 15 h » ; vide si aucune.
    in property <string> reset;
}

export component ClaudeQuotaWidget inherits WidgetFrame {
    empty: !ClaudeQuotaData.known;
    panel: "claude_quota";
    tip: ClaudeQuotaData.failed ? "Quota Claude illisible : " + ClaudeQuotaData.error : "";

    // Données périmées : tout le contenu estompé (`.stale`), pas l'îlot.
    Rectangle {
        opacity: ClaudeQuotaData.stale && !ClaudeQuotaData.failed ? Theme.o-stale : 1;
        HorizontalLayout {
            spacing: ClaudeQuotaData.failed ? 6px : 10px;
            Icon {
                y: (parent.height - self.height) / 2;
                source: @image-url("../../../icons/phosphor/chartDonut.svg");
                size: 13px;
                color: root.t.text-dim;
            }
            if !ClaudeQuotaData.failed: HorizontalLayout {
                spacing: 10px;
                for g in ClaudeQuotaData.gauges: Gauge {
                    t: root.t;
                    label: g.label;
                    value: g.value;
                    color: g.level == 2 ? root.t.bad : g.level == 1 ? root.t.warn : Theme.accent;
                }
                if root.wide && !root.compact && ClaudeQuotaData.reset != "": Text {
                    text: ClaudeQuotaData.reset;
                    color: root.t.text-dim;
                    font-family: root.t.font;
                    font-size: Theme.fs-meta;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                // Petit cercle des données périmées (`.stale-dot`).
                if ClaudeQuotaData.stale: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 5px;
                        height: 5px;
                        border-radius: 2.5px;
                        border-width: 1px;
                        border-color: root.t.text;
                    }
                }
            }
            if ClaudeQuotaData.failed: Text {
                text: "—";
                color: root.t.text-dim;
                font-family: Theme.font-mono;
                font-size: Theme.fs-meta;
                font-weight: 600;
                vertical-alignment: center;
            }
            if ClaudeQuotaData.failed: Icon {
                y: (parent.height - self.height) / 2;
                source: @image-url("../../../icons/phosphor/warning.svg");
                size: 12px;
                color: root.t.warn;
            }
        }
    }
}
