// Fenêtres d'Horizon, compilées par build.rs (types Rust dans `crate::ui`), et les globaux
// lus ou posés par Rust (un exemplaire par fenêtre). Les globaux des panneaux
// (`ui/widgets/<id>/panel.slint`) sont réexportés par `@panels`, généré par build.rs.

import { Theme, Styles, StyleTokens } from "theme.slint";
import { PluginFrames } from "plugin-view.slint";
import { Slot } from "components.slint";
import { BarWindow } from "bar.slint";
import { EssaiWindow } from "essai.slint";
import { PanelWindow } from "popup.slint";
// Fenêtre de réglages (src/ui/settings_window.rs, src/ui/options.rs) et palette (src/ui/palette.rs).
import { SettingsWindow } from "settings-window.slint";
import { SettingsLayout } from "settings/layout.slint";
import { SegmentChoice } from "settings/segmented.slint";
import { OptionsData, OptionsBar, StatusRow, SearchHit, PluginTile } from "options/data.slint";
import { PaletteWindow, PaletteRow, PaletteSeg } from "palette.slint";
// Réglages d'un widget et profils (src/ui/widget_settings/, src/ui/profiles.rs).
import { WidgetSettingsData } from "widget-settings/page.slint";
import { PluginSettingsData, PluginSettingRow } from "widget-settings/plugin.slint";
import { WeatherSettingsData, PlaceRow } from "widget-settings/weather.slint";
import { SuggestionsSettingsData, BlockedRow } from "widget-settings/suggestions.slint";
import { CalendarSettingsData, CalendarRow } from "widget-settings/calendar.slint";
import { ShortcutsSettingsData, ShortcutRow, ShortcutThumb, BrandChoice } from "widget-settings/shortcuts.slint";
import { ProfilesData, ProfileRow, ProfileApp } from "profiles/page.slint";
import { PhonePageData, PhoneRow } from "phone/page.slint";
import { Panels } from "panels.slint";
import { WheelHintState } from "wheel-hint.slint";
import { Tip } from "tooltip.slint";
// Îlot dynamique et témoins de la barre principale (src/ui/island.rs, src/ui/bar_status.rs).
import { FlashData } from "flash.slint";
import { BarStatusData } from "bar-status.slint";
import { OsdData } from "osd.slint";
import { PulseState } from "pulse.slint";
// Données des widgets portés (globales de chaque fenêtre, posées par src/widgets/<id>).
import { CalendarData, CalendarItem } from "widgets/calendar/widget.slint";
import { ClaudeSessionsData, ClaudeSessionRow } from "widgets/claude_sessions/widget.slint";
import { ClockData } from "widgets/clock/widget.slint";
import { DiscordVoiceData, VoiceAvatarRow } from "widgets/discord_voice/widget.slint";
import { HeadsetData } from "widgets/headset/widget.slint";
import { MediaData } from "widgets/media/widget.slint";
import { MicKrispData } from "widgets/mic_krisp/widget.slint";
import { NotifsData } from "widgets/notifications/widget.slint";
import { PhoneData, PhoneBattery } from "widgets/phone/widget.slint";
import { ShortcutsData, ShortcutItem } from "widgets/shortcuts/widget.slint";
import { SuggestionsData, SuggestionItem } from "widgets/suggestions/widget.slint";
import { Spark, SystemData } from "widgets/system/widget.slint";
import { WeatherData, WeatherItem, WeatherState } from "widgets/weather/widget.slint";
import { WindowsData } from "widgets/windows/widget.slint";

export { Styles, StyleTokens, PluginFrames, PluginSettingsData, PluginSettingRow }
export { Theme, Slot, BarWindow, EssaiWindow, PanelWindow, Panels, Tip, WheelHintState }
export { FlashData, BarStatusData }
export { OsdData, PulseState }
export { SettingsWindow, SettingsLayout, SegmentChoice, OptionsData, OptionsBar, StatusRow, SearchHit, PluginTile }
export { PaletteWindow, PaletteRow, PaletteSeg }
export { WidgetSettingsData, WeatherSettingsData, PlaceRow, SuggestionsSettingsData, BlockedRow, CalendarSettingsData, CalendarRow }
export { ShortcutsSettingsData, ShortcutRow, ShortcutThumb, BrandChoice }
export { ProfilesData, ProfileRow, ProfileApp, PhonePageData, PhoneRow }
// Panneaux des widgets (`PanelView` et leurs globaux), générés par build.rs.
export * from "@panels";
export { CalendarData, CalendarItem }
export { ClaudeSessionsData, ClaudeSessionRow, ClockData, DiscordVoiceData, VoiceAvatarRow }
export { MediaData, MicKrispData, PhoneData, PhoneBattery }
export { Spark, SystemData, WeatherData, WeatherItem, WeatherState }
export { HeadsetData, NotifsData, ShortcutsData, ShortcutItem, SuggestionsData, SuggestionItem, WindowsData }
