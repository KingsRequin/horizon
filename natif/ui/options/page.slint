// Page « Réglages d'Horizon » (app/src/settings/options/OptionsApp.svelte) : navigation des
// sections à gauche (188 px, filet à droite), section choisie à droite dans une vue qui défile.
// Tout s'applique à chaud et s'enregistre tout seul.

import { Theme } from "../theme.slint";
import { Icon } from "../components.slint";
import { FocusRing } from "../panel/focus.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsScroll } from "../settings/scroll.slint";
import { SettingsBanner } from "../settings/banner.slint";
import { SettingsNote } from "../settings/text.slint";
import { OptionsData } from "data.slint";
import { BarsSection } from "bars.slint";
import { AlertsSection } from "alerts.slint";
import { FeaturesSection } from "features.slint";
import { NightSection } from "night.slint";
import { TimerSection } from "timer.slint";
import { PaletteSection } from "palette.slint";
import { GeneralSection } from "general.slint";
import { StatusSection } from "status.slint";

component NavButton inherits Rectangle {
    in property <string> id;
    in property <string> label;
    in property <image> icon;
    property <bool> on: OptionsData.section == root.id;
    property <bool> keyboard;
    height: 31px;
    border-radius: Theme.r-lg;
    background: root.on ? Theme.accent.mix(SettingsLayout.t.surface-1, 0.16) : (area.has-hover ? SettingsLayout.t.surface-1 : transparent);
    FocusScope {
        focus-on-click: false;
        focus-gained(r) => {
            root.keyboard = r == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard = false;
        }
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                OptionsData.go(root.id);
                return accept;
            }
            reject
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            OptionsData.go(root.id);
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 9px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 15px;
                color: root.on || area.has-hover ? SettingsLayout.t.text : SettingsLayout.t.text-dim;
            }
        }
        Text {
            text: root.label;
            color: root.on || area.has-hover ? SettingsLayout.t.text : SettingsLayout.t.text-dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    if root.keyboard: FocusRing {
        width: root.width + 6px;
        height: root.height + 6px;
        radius: Theme.r-lg;
    }
}

export component OptionsPage inherits Rectangle {
    // Revient en haut de la page (changement de section).
    public function scroll-top() {
        scroll.scroll-top();
    }

    // Une seule page de la fenêtre pose la largeur du contenu : celle qui est affichée.
    changed visible => {
        if self.visible {
            SettingsLayout.content-w = scroll.content-w;
        }
    }

    // Navigation et page posées à la main : une mise en page ferait dépendre la taille de la
    // fenêtre de la largeur de la page, qui dépend d'elle (boucle de liaison).
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        Rectangle {
            x: 0;
            y: 0;
            width: 188px;
            height: parent.height;
            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 20px;
                padding-left: 10px;
                padding-right: 10px;
                spacing: 2px;
                alignment: start;
                Text {
                    // `h1` : marges 0 8 px 14 px.
                    x: 8px;
                    height: self.preferred-height + 14px;
                    vertical-alignment: top;
                    text: "Réglages d’Horizon";
                    color: SettingsLayout.t.text;
                    font-family: Theme.font-display;
                    font-size: Theme.fs-title;
                    font-weight: 600;
                }
                NavButton {
                    id: "barres";
                    label: "Barres";
                    icon: @image-url("../../icons/phosphor/squaresFour.svg");
                }
                NavButton {
                    id: "alertes";
                    label: "Alertes";
                    icon: @image-url("../../icons/phosphor/bellSimple.svg");
                }
                NavButton {
                    id: "fonctions";
                    label: "Fonctions";
                    icon: @image-url("../../icons/phosphor/lightning.svg");
                }
                NavButton {
                    id: "nuit";
                    label: "Nuit";
                    icon: @image-url("../../icons/phosphor/moon.svg");
                }
                NavButton {
                    id: "minuteur";
                    label: "Minuteur";
                    icon: @image-url("../../icons/phosphor/timer.svg");
                }
                NavButton {
                    id: "palette";
                    label: "Palette";
                    icon: @image-url("../../icons/phosphor/magnifyingGlass.svg");
                }
                NavButton {
                    id: "general";
                    label: "Général";
                    icon: @image-url("../../icons/phosphor/power.svg");
                }
                NavButton {
                    id: "etat";
                    label: "État";
                    icon: @image-url("../../icons/phosphor/pulse.svg");
                }
            }
            // Filet à droite de la navigation.
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: SettingsLayout.t.surface-1;
            }
        }
        scroll := SettingsScroll {
            // Largeur imposée : celle du contenu en dépend (textes qui passent à la ligne).
            x: 188px;
            y: 0;
            width: root.width - 188px;
            height: root.height;
            init => {
                if root.visible {
                    SettingsLayout.content-w = self.content-w;
                }
            }
            changed content-w => {
                if root.visible {
                    SettingsLayout.content-w = self.content-w;
                }
            }
            if OptionsData.loaded && OptionsData.file-error != "" && OptionsData.section != "etat": SettingsBanner {
                text: "settings.toml est illisible (" + OptionsData.file-error + ") : Horizon utilise les réglages par défaut et n’enregistre rien tant que le fichier n’est pas corrigé. Voir « État ».";
            }
            if OptionsData.loaded && OptionsData.section == "barres": BarsSection { }
            if OptionsData.loaded && OptionsData.section == "alertes": AlertsSection { }
            if OptionsData.loaded && OptionsData.section == "fonctions": FeaturesSection { }
            if OptionsData.loaded && OptionsData.section == "nuit": NightSection { }
            if OptionsData.loaded && OptionsData.section == "minuteur": TimerSection { }
            if OptionsData.loaded && OptionsData.section == "palette": PaletteSection { }
            if OptionsData.loaded && OptionsData.section == "general": GeneralSection { }
            if OptionsData.loaded && OptionsData.section == "etat": StatusSection { }
            if OptionsData.loaded && OptionsData.error != "": SettingsNote {
                text: OptionsData.error;
                tint: SettingsLayout.t.bad;
                font-size: Theme.fs-body;
                above: 12px;
            }
            if !OptionsData.loaded && OptionsData.load-error != "": SettingsNote {
                text: "Réglages impossibles à lire : " + OptionsData.load-error;
                tint: SettingsLayout.t.bad;
                font-size: Theme.fs-body;
            }
            if !OptionsData.loaded && OptionsData.load-error == "": SettingsNote {
                text: "Chargement…";
                font-size: Theme.fs-body;
            }
        }
    }
}
