// Page « Réglages d'Horizon » : à gauche la recherche et la navigation des sections (216 px,
// « État » en bas avec un point quand une intégration est en échec), à droite la section choisie
// (ou les réglages trouvés) dans une vue qui défile, colonne de 640 px au plus. Tout s'applique
// à chaud et s'enregistre tout seul.

import { Theme } from "../theme.slint";
import { Icon } from "../components.slint";
import { FocusRing } from "../panel/focus.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsScroll } from "../settings/scroll.slint";
import { SettingsBanner } from "../settings/banner.slint";
import { SettingsTitle, SettingsNote } from "../settings/text.slint";
import { InputField } from "../settings/input.slint";
import { Card } from "../settings/card.slint";
import { OptionsData, SearchHit } from "data.slint";
import { BarsSection } from "bars.slint";
import { ApparenceSection } from "apparence.slint";
import { SonSection } from "son.slint";
import { AlertsSection } from "alerts.slint";
import { TimerSection } from "timer.slint";
import { PaletteSection } from "palette.slint";
import { PluginsSection } from "plugins.slint";
import { GeneralSection } from "general.slint";
import { StatusSection } from "status.slint";

// Largeur de la navigation.
global Nav {
    out property <length> width: 216px;
}

component NavButton inherits Rectangle {
    in property <string> id;
    in property <string> label;
    in property <image> icon;
    // Point d'état à droite (couleur ; transparent : aucun).
    in property <color> dot: transparent;
    property <bool> on: OptionsData.section == root.id && !OptionsData.searching;
    property <bool> keyboard;
    height: 34px;
    border-radius: Theme.r-md;
    background: root.on || area.has-hover ? SettingsLayout.t.surface-1 : transparent;
    FocusScope {
        focus-on-click: false;
        focus-gained(r) => {
            root.keyboard = r == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard = false;
        }
        key-pressed(e) => {
            if e.text == " " || e.text == Key.Return {
                OptionsData.go(root.id);
                return accept;
            }
            reject
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            OptionsData.go(root.id);
        }
    }
    // Repère de la section choisie.
    if root.on: Rectangle {
        x: 0;
        y: 9px;
        width: 3px;
        height: root.height - 18px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                size: 16px;
                color: root.on || area.has-hover ? SettingsLayout.t.text : SettingsLayout.t.text-dim;
            }
        }
        Text {
            text: root.label;
            color: root.on || area.has-hover ? SettingsLayout.t.text : SettingsLayout.t.text-dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.dot != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot;
            }
        }
    }
    if root.keyboard: FocusRing {
        width: root.width + 6px;
        height: root.height + 6px;
        radius: Theme.r-md;
    }
}

// Réglage trouvé : où il est, et un clic y mène.
component Hit inherits Rectangle {
    in property <SearchHit> hit;
    property <bool> keyboard;
    VerticalLayout {
        padding-bottom: Card.gap;
        card := Rectangle {
            border-radius: Theme.r-md;
            background: area.has-hover ? Card.bg-hover : Card.bg;
            FocusScope {
                focus-on-click: false;
                focus-gained(r) => {
                    root.keyboard = r == FocusReason.tab-navigation;
                }
                focus-lost => {
                    root.keyboard = false;
                }
                key-pressed(e) => {
                    if e.text == " " || e.text == Key.Return {
                        OptionsData.go(root.hit.section);
                        return accept;
                    }
                    reject
                }
            }
            area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    OptionsData.go(root.hit.section);
                }
            }
            HorizontalLayout {
                padding-top: Card.pad-y;
                padding-bottom: Card.pad-y;
                padding-left: Card.pad-x;
                padding-right: Card.pad-x;
                spacing: Card.spacing;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        width: SettingsLayout.content-w - 2 * Card.pad-x - Card.spacing - 14px;
                        text: root.hit.label;
                        color: SettingsLayout.t.text;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.hit.place;
                        color: SettingsLayout.t.text-dim;
                        font-size: Theme.fs-meta;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("../../icons/phosphor/caretRight.svg");
                        size: 14px;
                        color: SettingsLayout.t.text-dim;
                    }
                }
            }
            if root.keyboard: FocusRing {
                width: card.width + 6px;
                height: card.height + 6px;
                radius: Theme.r-md;
            }
        }
    }
}

export component OptionsPage inherits Rectangle {
    // Revient en haut de la page (changement de section).
    public function scroll-top() {
        scroll.scroll-top();
    }

    // Une seule page de la fenêtre pose la largeur du contenu : celle qui est affichée.
    changed visible => {
        if self.visible {
            SettingsLayout.content-w = scroll.content-w;
        }
    }

    // Navigation et page posées à la main : une mise en page ferait dépendre la taille de la
    // fenêtre de la largeur de la page, qui dépend d'elle (boucle de liaison).
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        Rectangle {
            x: 0;
            y: 0;
            width: Nav.width;
            height: parent.height;
            VerticalLayout {
                padding-top: 14px;
                padding-bottom: 12px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 2px;
                Rectangle {
                    height: 32px + 12px;
                    VerticalLayout {
                        padding-bottom: 12px;
                        Rectangle {
                            border-radius: Theme.r-md;
                            background: SettingsLayout.t.surface-1;
                            HorizontalLayout {
                                padding-left: 10px;
                                spacing: 2px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon {
                                        source: @image-url("../../icons/phosphor/magnifyingGlass.svg");
                                        size: 14px;
                                        color: SettingsLayout.t.text-dim;
                                    }
                                }
                                InputField {
                                    value: OptionsData.query;
                                    placeholder: "Rechercher un réglage";
                                    quiet: true;
                                    edited(v) => {
                                        OptionsData.search(v);
                                    }
                                }
                            }
                            // Soulignement de la saisie.
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: SettingsLayout.t.surface-2;
                            }
                        }
                    }
                }
                NavButton {
                    id: "barres";
                    label: "Barres";
                    icon: @image-url("../../icons/phosphor/squaresFour.svg");
                }
                NavButton {
                    id: "apparence";
                    label: "Apparence";
                    icon: @image-url("../../icons/phosphor/paintBrush.svg");
                }
                NavButton {
                    id: "son";
                    label: "Son et média";
                    icon: @image-url("../../icons/phosphor/speakerHigh.svg");
                }
                NavButton {
                    id: "alertes";
                    label: "Alertes";
                    icon: @image-url("../../icons/phosphor/bellSimple.svg");
                }
                NavButton {
                    id: "minuteur";
                    label: "Minuteur";
                    icon: @image-url("../../icons/phosphor/timer.svg");
                }
                NavButton {
                    id: "palette";
                    label: "Palette";
                    icon: @image-url("../../icons/phosphor/keyboard.svg");
                }
                NavButton {
                    id: "plugins";
                    label: "Plugins";
                    icon: @image-url("../../icons/phosphor/puzzlePiece.svg");
                }
                NavButton {
                    id: "general";
                    label: "Général";
                    icon: @image-url("../../icons/phosphor/gearSix.svg");
                }
                Rectangle {
                    vertical-stretch: 1;
                }
                NavButton {
                    id: "etat";
                    label: "État";
                    icon: @image-url("../../icons/phosphor/pulse.svg");
                    dot: OptionsData.failing > 0 ? SettingsLayout.t.bad : transparent;
                }
            }
        }
        scroll := SettingsScroll {
            // Largeur imposée : celle du contenu en dépend (textes qui passent à la ligne).
            x: Nav.width;
            y: 0;
            width: root.width - Nav.width;
            height: root.height;
            init => {
                if root.visible {
                    SettingsLayout.content-w = self.content-w;
                }
            }
            changed content-w => {
                if root.visible {
                    SettingsLayout.content-w = self.content-w;
                }
            }
            if OptionsData.loaded && OptionsData.file-error != "" && OptionsData.section != "etat": SettingsBanner {
                text: "settings.toml est illisible (" + OptionsData.file-error + ") : Horizon utilise les réglages par défaut et n’enregistre rien tant que le fichier n’est pas corrigé. Voir « État ».";
            }
            if OptionsData.searching: VerticalLayout {
                SettingsTitle {
                    text: "Recherche";
                    description: OptionsData.hits.length == 0
                        ? "Aucun réglage ne correspond à « " + OptionsData.query + " »."
                        : (OptionsData.hits.length == 1 ? "Un réglage" : OptionsData.hits.length + " réglages") + " pour « " + OptionsData.query + " ». Un clic ouvre sa section.";
                }
                Rectangle {
                    height: 10px;
                }
                for h in OptionsData.hits: Hit {
                    hit: h;
                }
            }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "barres": BarsSection { }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "apparence": ApparenceSection { }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "son": SonSection { }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "alertes": AlertsSection { }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "minuteur": TimerSection { }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "palette": PaletteSection { }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "plugins": PluginsSection { }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "general": GeneralSection { }
            if OptionsData.loaded && !OptionsData.searching && OptionsData.section == "etat": StatusSection { }
            if OptionsData.loaded && OptionsData.error != "": SettingsNote {
                text: OptionsData.error;
                tint: SettingsLayout.t.bad;
                font-size: Theme.fs-body;
                above: 12px;
            }
            if !OptionsData.loaded && OptionsData.load-error != "": SettingsNote {
                text: "Réglages impossibles à lire : " + OptionsData.load-error;
                tint: SettingsLayout.t.bad;
                font-size: Theme.fs-body;
            }
            if !OptionsData.loaded && OptionsData.load-error == "": SettingsNote {
                text: "Chargement…";
                font-size: Theme.fs-body;
            }
        }
    }
}
