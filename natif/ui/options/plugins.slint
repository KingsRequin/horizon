// Section « Plugins » : une tuile par plugin installé (état, coût ou erreur, action : autoriser,
// activer, désactiver, réactiver, mettre à jour ; retrait de ceux venus de la bibliothèque), puis
// la bibliothèque (plugins publiés sur GitHub, permissions montrées, installés d'un clic). Grille posée à la main (deux colonnes au-delà de 440 px) :
// une mise en page qui dépendrait de la largeur de la fenêtre ferait une boucle de liaison.

import { Theme } from "../theme.slint";
import { Icon } from "../components.slint";
import { Tip } from "../tooltip.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsTitle, SettingsHeading, SettingsNote } from "../settings/text.slint";
import { SettingsButton } from "../settings/button.slint";
import { OptionsData, PluginTile } from "data.slint";

// Pastille d'état d'une tuile.
component Chip inherits Rectangle {
    in property <string> text;
    in property <int> level;
    property <color> tint: root.level == 0 ? SettingsLayout.t.ok : root.level == 2 ? SettingsLayout.t.bad : root.level == 3 ? Theme.accent : SettingsLayout.t.text-dim;
    height: 20px;
    width: label.preferred-width + 16px;
    border-radius: 10px;
    background: root.tint.mix(SettingsLayout.t.surface-1, 0.16);
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: Theme.fs-meta;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component Tile inherits Rectangle {
    in property <PluginTile> tile;
    // Retrait demandé : un second clic le confirme (effacement du dossier).
    property <bool> armed;
    property <length> text-w: root.width - 2 * 14px;
    border-radius: Theme.r-lg;
    background: SettingsLayout.t.surface-1;
    border-width: 1px;
    border-color: root.tile.level == 3 ? Theme.accent.mix(SettingsLayout.t.surface-1, 0.5) : (hover.has-hover ? SettingsLayout.t.surface-2 : SettingsLayout.t.surface-1);
    // Texte complet du bas de la tuile (il peut être coupé).
    hover := TouchArea {
        changed has-hover => {
            if self.has-hover && root.tile.detail != "" {
                Tip.show(root.tile.detail);
            } else if !self.has-hover {
                Tip.hide();
            }
        }
    }
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: Theme.r-lg;
                background: SettingsLayout.t.surface-2;
                Icon {
                    source: root.tile.icon;
                    size: 18px;
                    color: SettingsLayout.t.text;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 1;
                Text {
                    text: root.tile.name;
                    color: SettingsLayout.t.text;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.tile.meta != "": Text {
                    text: root.tile.meta;
                    color: SettingsLayout.t.text-dim;
                    font-size: Theme.fs-meta;
                    overflow: elide;
                }
            }
            // Pas de pastille dans la bibliothèque : tout y est « disponible ».
            if root.tile.chip != "": VerticalLayout {
                alignment: start;
                Chip {
                    text: root.tile.chip;
                    level: root.tile.level;
                }
            }
        }
        Text {
            width: root.text-w;
            height: 2 * 16px;
            text: root.tile.description != "" ? root.tile.description : "Pas de description.";
            color: root.tile.description != "" ? SettingsLayout.t.text-dim : SettingsLayout.t.text-dim.with-alpha(0.6);
            font-size: Theme.fs-meta;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.tile.detail;
                color: root.tile.level == 2 ? SettingsLayout.t.bad : SettingsLayout.t.text-dim;
                font-size: Theme.fs-meta;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.tile.folder-id != "": SettingsButton {
                small: true;
                tip: "Ouvrir le dossier";
                icon: @image-url("../../icons/phosphor/folderSimple.svg");
                padding-x: 6px;
                clicked => {
                    OptionsData.plugin-action(root.tile.folder-id);
                }
            }
            if root.tile.remove-id != "": SettingsButton {
                small: true;
                tip: root.armed ? "" : "Retirer ce plugin";
                icon: root.armed ? @image-url("") : @image-url("../../icons/phosphor/trash.svg");
                text: root.armed ? "Retirer ?" : "";
                padding-x: root.armed ? 11px : 6px;
                clicked => {
                    if root.armed {
                        root.armed = false;
                        OptionsData.plugin-action(root.tile.remove-id);
                    } else {
                        root.armed = true;
                    }
                }
                blurred => {
                    root.armed = false;
                }
            }
            if root.tile.action-label != "": SettingsButton {
                small: true;
                on: root.tile.level == 3;
                text: root.tile.action-label;
                clicked => {
                    OptionsData.plugin-action(root.tile.action-id);
                }
            }
        }
    }
}

// Grille de tuiles.
component Grid inherits Rectangle {
    in property <[PluginTile]> tiles;
    property <int> cols: SettingsLayout.content-w >= 440px ? 2 : 1;
    property <length> gap: 8px;
    property <length> tile-w: (SettingsLayout.content-w - (root.cols - 1) * root.gap) / root.cols;
    property <length> tile-h: 140px;
    width: SettingsLayout.content-w;
    height: ceil(root.tiles.length / root.cols) * (root.tile-h + root.gap) - (root.tiles.length > 0 ? root.gap : 0);
    for t[i] in root.tiles: Tile {
        tile: t;
        x: mod(i, root.cols) * (root.tile-w + root.gap);
        y: floor(i / root.cols) * (root.tile-h + root.gap);
        width: root.tile-w;
        height: root.tile-h;
    }
}

export component PluginsSection inherits VerticalLayout {
    SettingsTitle {
        text: "Plugins";
        description: "Un plugin ajoute un widget à tes barres. Il ne peut rien faire hors de ce que tu as autorisé.";
    }
    HorizontalLayout {
        padding-top: 6px;
        spacing: 6px;
        alignment: start;
        SettingsButton {
            text: "Nouveau plugin";
            small: true;
            icon: @image-url("../../icons/phosphor/plus.svg");
            tip: "Un modèle à modifier, avec son guide (PLUGINS.md), posé sur la barre principale";
            clicked => {
                OptionsData.plugin-action("plugin_new");
            }
        }
        SettingsButton {
            text: "Ouvrir le dossier des plugins";
            small: true;
            icon: @image-url("../../icons/phosphor/folderSimple.svg");
            tip: OptionsData.plugins-dir;
            clicked => {
                OptionsData.plugin-action("plugins_dir");
            }
        }
    }
    if OptionsData.plugins-error != "": SettingsNote {
        text: OptionsData.plugins-error;
        tint: SettingsLayout.t.bad;
        font-size: Theme.fs-body;
        above: 10px;
    }

    SettingsHeading {
        text: "Installés";
    }
    if OptionsData.plugins.length > 0: Grid {
        tiles: OptionsData.plugins;
    }
    if OptionsData.plugins.length == 0: Rectangle {
        border-radius: Theme.r-lg;
        border-width: 1px;
        border-color: SettingsLayout.t.surface-2;
        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            Text {
                text: "Aucun plugin installé";
                color: SettingsLayout.t.text;
                font-weight: 600;
            }
            Text {
                width: SettingsLayout.content-w - 32px;
                text: "Copie le dossier d’un plugin dans le dossier des plugins : il apparaît ici en moins d’une seconde, puis s’ajoute à une barre en mode édition (« Ajouter un widget »).";
                color: SettingsLayout.t.text-dim;
                font-size: Theme.fs-meta;
                wrap: word-wrap;
            }
        }
    }

    SettingsHeading {
        text: "Bibliothèque";
        below: 2px;
    }
    SettingsNote {
        text: "Plugins publiés sur GitHub (KingsRequin/horizon-plugins). Ce qu’un plugin demande est montré avant l’installation ; ceux installés d’ici se mettent à jour d’eux-mêmes.";
        below: 10px;
    }
    if OptionsData.library-error != "": SettingsNote {
        text: "Bibliothèque injoignable : " + OptionsData.library-error;
        tint: SettingsLayout.t.bad;
        below: 8px;
    }
    if OptionsData.library.length > 0: Grid {
        tiles: OptionsData.library;
    }
    if OptionsData.library.length == 0: Rectangle {
        border-radius: Theme.r-lg;
        border-width: 1px;
        border-color: SettingsLayout.t.surface-2;
        HorizontalLayout {
            padding: 16px;
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                Icon {
                    source: @image-url("../../icons/phosphor/downloadSimple.svg");
                    size: 18px;
                    color: SettingsLayout.t.text-dim;
                }
            }
            Text {
                width: SettingsLayout.content-w - 32px - 18px - 12px;
                text: OptionsData.library-known ? "Tous les plugins de la bibliothèque sont installés." : OptionsData.library-error != "" ? "La liste reviendra à la prochaine lecture de l’index." : "Lecture de la bibliothèque…";
                color: SettingsLayout.t.text-dim;
                font-size: Theme.fs-meta;
                wrap: word-wrap;
            }
        }
    }
}
