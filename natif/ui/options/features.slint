// Section « Fonctions » (app/src/settings/options/FeaturesSection.svelte) : fonctions
// facultatives (`[features]` de settings.toml).

import { SettingsLayout } from "../settings/layout.slint";
import { SettingsHeading, SettingsNote } from "../settings/text.slint";
import { SettingRow } from "../settings/row.slint";
import { SettingCheck } from "../settings/check.slint";
import { SelectField } from "../settings/field.slint";
import { OptionsData } from "data.slint";

component Feature inherits SettingCheck {
    in property <string> key;
    // Désactivée en plus du fichier illisible.
    in property <bool> off;
    enabled: !OptionsData.locked && !root.off;
    toggled(v) => {
        OptionsData.toggle(root.key, v);
    }
}

export component FeaturesSection inherits VerticalLayout {
    SettingsHeading {
        text: "Captures d’écran vers Claude";
        first: true;
    }
    Feature {
        key: "features.capture_to_claude";
        checked: OptionsData.capture-to-claude;
        label: "Proposer chaque nouvelle capture à la session Claude qui attend";
        hint: "L’îlot montre la miniature quelques secondes ; un clic ramène le terminal et y colle le chemin de l’image. Rien n’est envoyé : à toi d’appuyer sur Entrée.";
    }
    SettingsNote {
        text: "Dossier surveillé : Images › Captures d’écran (Win+Maj+S, Impr. écran). Sans session qui attend ou terminée, rien n’est proposé.";
        above: 6px;
    }

    SettingsHeading {
        text: "Casque éteint";
    }
    SettingRow {
        label: "Sortie de repli";
        hint: "Où va le son quand le casque s’éteint (enceintes, écran).";
        SelectField {
            text: OptionsData.fallback-output;
            enabled: !OptionsData.locked;
            open(x, y) => {
                OptionsData.pick("features.fallback_output", x, y);
            }
        }
    }
    Feature {
        key: "features.headset_switch";
        checked: OptionsData.headset-switch && OptionsData.fallback-chosen;
        off: !OptionsData.fallback-chosen;
        label: "Basculer le son quand le casque s’éteint, et revenir quand il se rallume";
        hint: OptionsData.fallback-chosen
            ? "Le casque est relu toutes les 5 s ; deux lectures « éteint » d’affilée et 15 s au moins entre deux bascules. Une sortie choisie à la main entre-temps est gardée."
            : "Choisis d’abord la sortie de repli.";
    }
    if OptionsData.fallback-missing: SettingsNote {
        text: "La sortie de repli n’est pas branchée : la bascule attend son retour.";
        tint: SettingsLayout.t.warn;
        above: 6px;
    }

    SettingsHeading {
        text: "Volume et média";
    }
    Feature {
        key: "features.osd";
        checked: OptionsData.osd;
        label: "Afficher le volume et la lecture dans la barre principale, à la place de Windows";
        hint: "Touches de volume et de lecture (clavier, casque), volume changé par une autre appli. L’affichage de Windows est masqué tant que la barre principale est visible ; il revient en plein écran et quand cette case est décochée.";
    }
    Feature {
        key: "features.osd_track";
        checked: OptionsData.osd && OptionsData.osd-track;
        off: !OptionsData.osd;
        label: "Annoncer chaque nouveau morceau";
        hint: "Pochette, titre et artiste quelques secondes au centre de la barre.";
    }

    SettingsHeading {
        text: "Pulsation";
    }
    Feature {
        key: "features.bar_pulse";
        checked: OptionsData.bar-pulse;
        label: "Faire vivre les barres avec la musique";
        hint: "Pendant la lecture, le bord des îlots prend la couleur de la pochette, s’éclaire avec la basse et flashe à chaque grosse caisse (le même kick qu’Essaim). Coupé si Windows demande moins d’animations.";
    }

    SettingsHeading {
        text: "Couleur du fond d’écran";
    }
    Feature {
        key: "features.wallpaper_accent";
        checked: OptionsData.wallpaper-accent;
        label: "Prendre la couleur du fond d’écran quand rien ne joue";
        hint: "Relue chaque minute sur l’écran principal (Wallpaper Engine compris, listes de lecture aussi) : accent des barres et des plugins (ambiance de Prisme, donc teinte d’Essaim). Pendant la lecture, c’est toujours la pochette.";
    }
    Feature {
        key: "features.windows_accent";
        checked: OptionsData.wallpaper-accent && OptionsData.windows-accent;
        off: !OptionsData.wallpaper-accent;
        label: "L’appliquer aussi à la couleur d’accent de Windows";
        hint: "Menu Démarrer, paramètres, boutons et sélections. La couleur choisie avant est gardée de côté et remise dès que cette case ou la précédente est décochée.";
    }

    SettingsHeading {
        text: "Mode jeu";
    }
    Feature {
        key: "features.game_mode";
        checked: OptionsData.game-mode;
        label: "Alléger Horizon quand une appli est en plein écran sur l’écran principal";
        hint: "Spectre et capture du son coupés, mesures système toutes les 6 s au lieu de chaque seconde (sauf panneau Système ouvert), import de l’historique Vivaldi retardé. Tout reprend à la sortie du plein écran.";
    }

    if OptionsData.updates: VerticalLayout {
        SettingsHeading {
            text: "Mises à jour";
        }
        Feature {
            key: "features.auto_update";
            checked: OptionsData.auto-update;
            label: "Installer automatiquement les nouvelles versions";
            hint: "Cherchée sur GitHub au démarrage puis deux fois par jour, téléchargée et vérifiée (empreinte SHA-256), puis installée au démarrage suivant. Réglages d’Horizon › État : l’installer tout de suite.";
        }
    }
}
