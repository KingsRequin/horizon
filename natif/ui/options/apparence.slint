// Section « Apparence » : animations de la musique (fond de la lecture en cours, pulsation des
// barres), couleur du fond d'écran (et accent de Windows), nuit (plage horaire, luminosité des
// barres non cliquables, « Ne pas déranger »). Options de `[features]`, `[music]` et `[night]`
// de settings.toml.

import { Theme } from "../theme.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsTitle, SettingsHeading } from "../settings/text.slint";
import { SettingRow } from "../settings/row.slint";
import { SettingCheck } from "../settings/check.slint";
import { SettingExpander } from "../settings/expander.slint";
import { CommitField, SelectField } from "../settings/field.slint";
import { Slider } from "../panel/slider.slint";
import { OptionsData } from "data.slint";

export component ApparenceSection inherits VerticalLayout {
    SettingsTitle {
        text: "Apparence";
        description: "Couleurs qui suivent la musique ou le fond d’écran, et barres assombries la nuit.";
    }

    SettingsHeading {
        text: "Musique";
    }
    SettingRow {
        label: "Fond de la lecture en cours";
        hint: OptionsData.music-backdrop-hint;
        SelectField {
            text: OptionsData.music-backdrop;
            enabled: !OptionsData.locked;
            open(x, y) => {
                OptionsData.pick("music.backdrop", x, y);
            }
        }
    }
    SettingExpander {
        checked: OptionsData.bar-pulse;
        enabled: !OptionsData.locked;
        expanded: OptionsData.bar-pulse;
        label: "Faire vivre les barres avec la musique";
        hint: "Pendant la lecture, les barres prennent la couleur de la pochette et suivent la basse et la grosse caisse (le même kick qu’Essaim). Coupé si Windows demande moins d’animations.";
        toggled(v) => {
            OptionsData.toggle("features.bar_pulse", v);
        }
        SettingRow {
            nested: true;
            enabled: OptionsData.bar-pulse;
            label: "Animation";
            hint: OptionsData.music-pulse-hint;
            SelectField {
                text: OptionsData.music-pulse;
                enabled: !OptionsData.locked && OptionsData.bar-pulse;
                open(x, y) => {
                    OptionsData.pick("music.pulse", x, y);
                }
            }
        }
    }

    SettingsHeading {
        text: "Couleur du fond d’écran";
    }
    SettingExpander {
        checked: OptionsData.wallpaper-accent;
        enabled: !OptionsData.locked;
        expanded: OptionsData.wallpaper-accent;
        label: "Prendre la couleur du fond d’écran quand rien ne joue";
        hint: "Relue chaque minute sur l’écran principal (Wallpaper Engine compris, listes de lecture aussi) : accent des barres et des plugins (ambiance de Prisme, donc teinte d’Essaim). Pendant la lecture, c’est la pochette.";
        toggled(v) => {
            OptionsData.toggle("features.wallpaper_accent", v);
        }
        SettingCheck {
            nested: true;
            checked: OptionsData.wallpaper-accent && OptionsData.windows-accent;
            enabled: !OptionsData.locked && OptionsData.wallpaper-accent;
            label: "L’appliquer aussi à la couleur d’accent de Windows";
            hint: "Menu Démarrer, paramètres, boutons et sélections. La couleur d’avant est gardée de côté et remise dès que l’une des deux options est coupée.";
            toggled(v) => {
                OptionsData.toggle("features.windows_accent", v);
            }
        }
    }

    SettingsHeading {
        text: "Nuit";
    }
    SettingRow {
        label: "Début et fin";
        hint: "La nuit, les barres qui ne sont pas cliquables (« Survol seul », « Information seule ») s’assombrissent.";
        CommitField {
            value: OptionsData.night-start;
            enabled: !OptionsData.locked;
            committed(v) => {
                OptionsData.text("night.start", v);
            }
        }
        Text {
            text: "→";
            color: SettingsLayout.t.text-dim;
            vertical-alignment: center;
        }
        CommitField {
            value: OptionsData.night-end;
            enabled: !OptionsData.locked;
            committed(v) => {
                OptionsData.text("night.end", v);
            }
        }
    }
    SettingRow {
        label: "Luminosité la nuit";
        hint: "100 % = comme le jour.";
        VerticalLayout {
            alignment: center;
            Slider {
                t: SettingsLayout.t;
                width: 130px;
                value: OptionsData.night-percent;
                minimum: 10;
                maximum: 100;
                step: 5;
                enabled: !OptionsData.locked;
                moved(v) => {
                    OptionsData.number("night.opacity", round(v));
                }
                released(v) => {
                    OptionsData.number("night.opacity", round(v));
                }
            }
        }
        Text {
            width: 42px;
            text: OptionsData.night-percent + " %";
            color: SettingsLayout.t.text;
            font-family: Theme.font-mono;
            font-weight: 500;
            font-size: Theme.fs-meta;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    SettingCheck {
        checked: OptionsData.night-dnd;
        enabled: !OptionsData.locked;
        label: "« Ne pas déranger » pendant la nuit";
        hint: "Activé au début de la nuit, coupé au matin. Coupé à la main, il ne revient que la nuit suivante.";
        toggled(v) => {
            OptionsData.toggle("night.dnd", v);
        }
    }
}
