// Section « Nuit » (app/src/settings/options/NightSection.svelte) : plage horaire, luminosité des
// barres non cliquables (appliquée tout de suite), « Ne pas déranger » la nuit.

import { Theme } from "../theme.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsHeading, SettingsNote } from "../settings/text.slint";
import { SettingRow } from "../settings/row.slint";
import { SettingCheck } from "../settings/check.slint";
import { CommitField } from "../settings/field.slint";
import { Slider } from "../panel/slider.slint";
import { OptionsData } from "data.slint";

export component NightSection inherits VerticalLayout {
    SettingsHeading {
        text: "Nuit";
        first: true;
        below: 8px;
    }
    SettingsNote {
        text: "La nuit, les barres qui ne sont pas cliquables (« Survol seul », « Information seule ») s’assombrissent.";
        below: 14px;
    }
    SettingRow {
        label: "Début";
        CommitField {
            value: OptionsData.night-start;
            enabled: !OptionsData.locked;
            committed(v) => {
                OptionsData.text("night.start", v);
            }
        }
    }
    SettingRow {
        label: "Fin";
        CommitField {
            value: OptionsData.night-end;
            enabled: !OptionsData.locked;
            committed(v) => {
                OptionsData.text("night.end", v);
            }
        }
    }
    SettingRow {
        label: "Luminosité la nuit";
        hint: "100 % = comme le jour.";
        VerticalLayout {
            alignment: center;
            Slider {
                t: SettingsLayout.t;
                width: 130px;
                value: OptionsData.night-percent;
                minimum: 10;
                maximum: 100;
                step: 5;
                enabled: !OptionsData.locked;
                moved(v) => {
                    OptionsData.number("night.opacity", round(v));
                }
                released(v) => {
                    OptionsData.number("night.opacity", round(v));
                }
            }
        }
        Text {
            width: 42px;
            text: OptionsData.night-percent + " %";
            color: SettingsLayout.t.text;
            font-family: Theme.font-mono;
            font-weight: 500;
            font-size: Theme.fs-meta;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
    SettingCheck {
        checked: OptionsData.night-dnd;
        enabled: !OptionsData.locked;
        label: "« Ne pas déranger » pendant la nuit";
        hint: "Activé au début de la nuit, coupé au matin. Coupé à la main, il ne revient que la nuit suivante.";
        toggled(v) => {
            OptionsData.toggle("night.dnd", v);
        }
    }
}
