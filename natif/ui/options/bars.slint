// Section « Barres » (app/src/settings/options/BarsSection.svelte) : style, interaction, tuiles
// (sous la barre ou dans un volet), hauteur (sous la barre seulement), masquage en plein écran
// et animations de la musique de chaque barre (layout.json, appliqués aussitôt et annulables par
// Ctrl+Z en mode édition), puis réapparition au-dessus d'un plein écran.

import { Theme } from "../theme.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsTitle, SettingsHeading, SettingsNote } from "../settings/text.slint";
import { SettingRow } from "../settings/row.slint";
import { SettingCheck } from "../settings/check.slint";
import { Segmented } from "../settings/segmented.slint";
import { NumberField, SelectField } from "../settings/field.slint";
import { OptionsData } from "data.slint";

export component BarsSection inherits VerticalLayout {
    SettingsTitle {
        text: "Barres";
        description: "Chaque écran a sa barre. Le style et les animations de la musique se changent aussi par clic droit sur la barre.";
    }
    for b in OptionsData.bars: VerticalLayout {
        Rectangle {
            opacity: b.connected ? 1 : Theme.o-stale;
            VerticalLayout {
                SettingsHeading {
                    text: b.connected ? b.name : b.name + " · écran débranché";
                }
                SettingRow {
                    label: "Style";
                    Segmented {
                        value: b.style;
                        choices: OptionsData.styles;
                        selected(v) => {
                            OptionsData.bar(b.monitor-id, "style", v);
                        }
                    }
                }
                SettingRow {
                    label: "Souris";
                    hint: b.interaction-hint;
                    Segmented {
                        value: b.interaction;
                        choices: OptionsData.modes;
                        selected(v) => {
                            OptionsData.bar(b.monitor-id, "interaction", v);
                        }
                    }
                }
                SettingRow {
                    label: "Tuiles";
                    hint: b.tiles-hint;
                    Segmented {
                        value: b.tiles;
                        choices: OptionsData.tiles-modes;
                        selected(v) => {
                            OptionsData.bar(b.monitor-id, "tiles", v);
                        }
                    }
                }
                if b.tiles == "fixed": SettingRow {
                    label: "Hauteur";
                    hint: b.height-hint;
                    VerticalLayout {
                        spacing: 6px;
                        alignment: center;
                        Segmented {
                            value: b.height-choice;
                            choices: OptionsData.heights;
                            selected(v) => {
                                OptionsData.bar(b.monitor-id, "height", v);
                            }
                        }
                        if b.height-choice == "custom": HorizontalLayout {
                            alignment: end;
                            spacing: 4px;
                            NumberField {
                                value: b.height;
                                minimum: 40;
                                maximum: 900;
                                step: 10;
                                committed(v) => {
                                    OptionsData.bar(b.monitor-id, "height-typed", v);
                                }
                            }
                            Text {
                                text: "px";
                                color: SettingsLayout.t.text-dim;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                SettingCheck {
                    checked: b.autohide;
                    label: "Masquer au-dessus d’une appli en plein écran";
                    hint: "La barre revient quand la souris s’arrête en haut de l’écran.";
                    toggled(v) => {
                        OptionsData.bar(b.monitor-id, "autohide", v ? "true" : "false");
                    }
                }
                // Animations de la musique de cette barre (le fond et la progression sont ceux
                // du widget Lecture en cours : grisés sans lui).
                SettingRow {
                    label: "Musique : animation";
                    hint: b.music-pulse-hint;
                    SelectField {
                        text: b.music-pulse;
                        open(x, y) => {
                            OptionsData.pick("bar.pulse|" + b.monitor-id, x, y);
                        }
                    }
                }
                SettingRow {
                    label: "Musique : fond de la lecture en cours";
                    hint: b.has-media ? b.music-backdrop-hint : "Sans effet : cette barre n’a pas de widget Lecture en cours.";
                    enabled: b.has-media;
                    SelectField {
                        text: b.music-backdrop;
                        enabled: b.has-media;
                        open(x, y) => {
                            OptionsData.pick("bar.backdrop|" + b.monitor-id, x, y);
                        }
                    }
                }
                SettingRow {
                    label: "Musique : barre de progression";
                    hint: b.has-media ? b.music-progress-hint : "Sans effet : cette barre n’a pas de widget Lecture en cours.";
                    enabled: b.has-media;
                    SelectField {
                        text: b.music-progress;
                        enabled: b.has-media;
                        open(x, y) => {
                            OptionsData.pick("bar.progress|" + b.monitor-id, x, y);
                        }
                    }
                }
            }
        }
    }
    if OptionsData.bars-error != "": SettingsNote {
        text: OptionsData.bars-error;
        tint: SettingsLayout.t.bad;
        font-size: Theme.fs-body;
    }

    SettingsHeading {
        text: "Réapparition au-dessus d’un plein écran";
    }
    SettingCheck {
        checked: OptionsData.reveal;
        enabled: !OptionsData.locked;
        label: "Faire revenir la barre avec la souris";
        hint: "Décoché : une barre masquée ne revient qu’à la fin du plein écran (jeu dont les menus touchent le haut de l’écran). Un curseur caché par un jeu ne la fait jamais revenir.";
        toggled(v) => {
            OptionsData.toggle("autohide.reveal", v);
        }
    }
    SettingRow {
        label: "Hauteur de la bande du haut";
        hint: "Où la souris fait revenir une barre masquée.";
        NumberField {
            value: OptionsData.reveal-px;
            minimum: 0;
            maximum: 200;
            enabled: !OptionsData.locked && OptionsData.reveal;
            committed(v) => {
                OptionsData.number("autohide.reveal_px", v);
            }
        }
        Text {
            text: "px";
            color: SettingsLayout.t.text;
            vertical-alignment: center;
        }
    }
    SettingRow {
        label: "Temps d’arrêt de la souris";
        hint: "La traverser pour changer d’écran ne fait rien revenir.";
        NumberField {
            value: OptionsData.reveal-ms;
            minimum: 0;
            maximum: 5000;
            step: 50;
            enabled: !OptionsData.locked && OptionsData.reveal;
            committed(v) => {
                OptionsData.number("autohide.reveal_ms", v);
            }
        }
        Text {
            text: "ms";
            color: SettingsLayout.t.text;
            vertical-alignment: center;
        }
    }
}
