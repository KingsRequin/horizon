// Section « État » (app/src/settings/options/StatusSection.svelte) : l'état réel de chaque
// intégration, les derniers avertissements du journal et quelques actions. Relue à l'ouverture,
// toutes les 15 s tant qu'elle est affichée (src/ui/options.rs), et sur demande.

import { Theme } from "../theme.slint";
import { Icon } from "../components.slint";
import { StatusDot } from "../widget-frame.slint";
import { SettingsLayout } from "../settings/layout.slint";
import { SettingsNote } from "../settings/text.slint";
import { SettingsButton } from "../settings/button.slint";
import { OptionsData, StatusRow } from "data.slint";

// En-tête : titre à gauche, bouton à droite.
component Head inherits Rectangle {
    in property <string> text;
    in property <bool> first;
    VerticalLayout {
        padding-top: root.first ? 0 : 22px;
        padding-bottom: 10px;
        HorizontalLayout {
            Text {
                text: root.text;
                color: SettingsLayout.t.text;
                font-family: Theme.font-display;
                font-size: Theme.fs-title;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            @children
        }
    }
}

component CheckLine inherits Rectangle {
    in property <StatusRow> check;
    property <bool> has-action: check.action-label != "";
    property <length> act-w: root.has-action ? act.preferred-width + 11px : 0;
    property <length> text-w: SettingsLayout.content-w - 20px - 8px - 11px - root.act-w;
    border-radius: Theme.r-lg;
    background: check.level == 2 ? SettingsLayout.t.bad.mix(SettingsLayout.t.surface-1, 0.10) : SettingsLayout.t.surface-1;
    HorizontalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 10px;
        padding-right: 10px;
        VerticalLayout {
            padding-right: 11px;
            alignment: center;
            StatusDot {
                size: 8px;
                fill: check.level == 0 ? SettingsLayout.t.ok : check.level == 2 ? SettingsLayout.t.bad : SettingsLayout.t.text-dim;
                hollow: check.level == 1;
                ring: SettingsLayout.t.text-dim;
            }
        }
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                width: root.text-w;
                text: check.label;
                color: SettingsLayout.t.text;
                font-weight: 500;
                wrap: word-wrap;
            }
            Text {
                width: root.text-w;
                text: check.detail;
                color: SettingsLayout.t.text-dim;
                font-size: Theme.fs-meta;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            width: root.act-w;
            padding-left: root.has-action ? 11px : 0;
            alignment: center;
            act := SettingsButton {
                visible: root.has-action;
                text: check.action-label;
                small: true;
                clicked => {
                    OptionsData.status-action(check.action-id);
                }
            }
        }
    }
}

export component StatusSection inherits VerticalLayout {
    Head {
        text: "État";
        first: true;
        SettingsButton {
            text: "Relire";
            tip: "Relire";
            small: true;
            icon: @image-url("../../icons/phosphor/arrowsClockwise.svg");
            clicked => {
                OptionsData.status-reload();
            }
        }
    }
    if OptionsData.status-loaded: VerticalLayout {
        HorizontalLayout {
            padding-bottom: 12px;
            spacing: 8px;
            alignment: start;
            VerticalLayout {
                alignment: start;
                padding-top: 1px;
                Icon {
                    source: OptionsData.failing == 0 ? @image-url("../../icons/phosphor/checkCircle.svg") : @image-url("../../icons/phosphor/warning.svg");
                    size: 14px;
                    color: OptionsData.failing == 0 ? SettingsLayout.t.ok : SettingsLayout.t.bad;
                }
            }
            Text {
                width: SettingsLayout.content-w - 22px;
                text: OptionsData.failing == 0 ? "Tout fonctionne." : (OptionsData.failing == 1 ? "Une intégration en échec" : OptionsData.failing + " intégrations en échec") + " : un « ! » le signale sur la barre principale et un point orange sur l’icône de notification.";
                color: OptionsData.failing == 0 ? SettingsLayout.t.ok : SettingsLayout.t.bad;
                font-size: Theme.fs-meta;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            spacing: 4px;
            for c in OptionsData.checks: CheckLine {
                check: c;
            }
        }
        if OptionsData.action-error != "": SettingsNote {
            text: OptionsData.action-error;
            tint: SettingsLayout.t.bad;
            font-size: Theme.fs-body;
            above: 12px;
        }
        Head {
            text: "Journal";
            SettingsButton {
                text: "Ouvrir le journal";
                small: true;
                icon: @image-url("../../icons/phosphor/fileText.svg");
                clicked => {
                    OptionsData.open-log();
                }
            }
        }
        if OptionsData.warnings.length > 0: VerticalLayout {
            spacing: 4px;
            for w in OptionsData.warnings: Rectangle {
                border-radius: Theme.r-md;
                background: Theme.field-bg;
                VerticalLayout {
                    padding-top: 5px;
                    padding-bottom: 5px;
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        width: SettingsLayout.content-w - 20px;
                        text: w;
                        color: SettingsLayout.t.text-dim;
                        font-family: Theme.font-mono;
                        font-weight: 500;
                        font-size: Theme.fs-meta;
                        wrap: char-wrap;
                    }
                }
            }
        }
        if OptionsData.warnings.length == 0: SettingsNote {
            text: "Aucun avertissement récent.";
        }
        SettingsNote {
            text: OptionsData.log-path;
            font-family: Theme.font-mono;
            above: 8px;
        }
    }
    if !OptionsData.status-loaded && OptionsData.status-error != "": SettingsNote {
        text: "État impossible à lire : " + OptionsData.status-error;
        tint: SettingsLayout.t.bad;
        font-size: Theme.fs-body;
    }
    if !OptionsData.status-loaded && OptionsData.status-error == "": SettingsNote {
        text: "Chargement…";
    }
}
