// Page « Effets » (apps/prisme/pages/Scenes.svelte) : la liste des scènes à gauche (création), et
// l'éditeur de la scène choisie : effet, réglages, aperçu en direct, essai sur les LED.
// Données : global `PrismeScenes` (src/prisme_window/scenes.rs).

import { PrismeTheme } from "theme.slint";
import { PText, PButton, PField, PSelect, PRow, PHint, PScroll } from "controls.slint";
import { CanvasView } from "canvas.slint";
import { ParamRow, PrismeParam, PrismeOption } from "params.slint";

export { PrismeParam, PrismeOption }

export struct PrismeSceneRow {
    key: string,
    label: string,
    // Effet de la scène.
    kind: string,
    active: bool,
}

export global PrismeScenes {
    // Brouillon de la config chargé.
    in property <bool> ready;
    in property <[PrismeSceneRow]> scenes;
    in property <string> new-name;
    in property <string> name-error;
    in property <bool> has-selected;
    in property <string> title;
    in property <string> summary;
    // La scène est affichée en ce moment (scène forcée).
    in property <bool> shown;
    in property <bool> can-remove;
    in property <string> remove-tip;
    in property <string> effect;
    in property <[PrismeParam]> params;
    callback select(string);
    callback edit-name(string);
    callback create();
    callback remove();
    callback try-now();
    callback back-auto();
    callback pick-effect(length, length);
    callback set-number(string, float);
    callback set-bool(string, bool);
    callback pick-color(string, int);
    callback pick-option(string, length, length);
    callback toggle-option(string, string, bool);
    callback add-color(string);
    callback remove-color(string, int);
}

component SceneItem inherits PButton {
    in property <PrismeSceneRow> scene;
    kind: 3;
    align: left;
    text: "";
    flat-bg: self.scene.active ? PrismeTheme.live-soft : transparent;
    horizontal-stretch: 1;
    height: 34px;
    HorizontalLayout {
        padding-left: 15px;
        padding-right: 15px;
        spacing: 8px;
        PText {
            text: root.scene.label;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        PText {
            text: root.scene.kind;
            color: PrismeTheme.faint;
            font-size: PrismeTheme.fs-small;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0;
        }
    }
}

export component ScenesPage inherits Rectangle {
    if PrismeScenes.ready: PScroll {
        content-height: page.preferred-height;
        page := HorizontalLayout {
            width: parent.width;
            alignment: start;
            min-height: root.height;
            // Liste des scènes.
            Rectangle {
                width: 250px;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: PrismeTheme.line;
                }
                VerticalLayout {
                    alignment: start;
                    padding-top: 28px;
                    padding-bottom: 28px;
                    padding-left: 24px;
                    padding-right: 17px;
                    spacing: 12px;
                    PText {
                        text: "Scènes";
                        font-size: PrismeTheme.h2;
                        font-weight: 600;
                    }
                    VerticalLayout {
                        spacing: 2px;
                        for s in PrismeScenes.scenes: SceneItem {
                            scene: s;
                            clicked => {
                                PrismeScenes.select(s.key);
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        PField {
                            value: PrismeScenes.new-name;
                            follow: true;
                            placeholder: "Nom de la scène";
                            edited(t) => {
                                PrismeScenes.edit-name(t);
                            }
                            // Entrée : envoi du formulaire (la sortie du champ ne crée rien).
                            accepted(t) => {
                                PrismeScenes.create();
                            }
                        }
                        PButton {
                            text: "Créer";
                            enabled: PrismeScenes.new-name != "" && PrismeScenes.name-error == "";
                            clicked => {
                                PrismeScenes.create();
                            }
                        }
                    }
                    if PrismeScenes.name-error != "": PHint {
                        text: PrismeScenes.name-error;
                        color: PrismeTheme.danger;
                    }
                }
            }
            // Éditeur de la scène choisie.
            if PrismeScenes.has-selected: Rectangle {
                horizontal-stretch: 1;
                // `max-width: 820px` (marges comprises).
                max-width: 820px;
                VerticalLayout {
                    alignment: start;
                    padding-top: 28px;
                    padding-bottom: 28px;
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 16px;
                        padding-bottom: 4px;
                        VerticalLayout {
                            spacing: 4px;
                            horizontal-stretch: 1;
                            PText {
                                text: PrismeScenes.title;
                                font-size: PrismeTheme.h1;
                                font-weight: 600;
                            }
                            PText {
                                text: PrismeScenes.summary;
                                color: PrismeTheme.muted;
                                wrap: word-wrap;
                            }
                            if PrismeScenes.shown: PText {
                                text: "Affichée en ce moment : tes réglages s'appliquent en direct.";
                                color: PrismeTheme.live;
                                font-size: PrismeTheme.fs-13;
                                wrap: word-wrap;
                            }
                        }
                        VerticalLayout {
                            alignment: start;
                            HorizontalLayout {
                                spacing: 6px;
                                if PrismeScenes.shown: PButton {
                                    kind: 1;
                                    text: "Revenir en automatique";
                                    tip: "Les règles automatiques reprennent la main";
                                    clicked => {
                                        PrismeScenes.back-auto();
                                    }
                                }
                                if !PrismeScenes.shown: PButton {
                                    text: "Essayer";
                                    tip: "Affiche cette scène sur les LED pour régler en direct";
                                    clicked => {
                                        PrismeScenes.try-now();
                                    }
                                }
                                PButton {
                                    kind: 2;
                                    text: "Supprimer";
                                    enabled: PrismeScenes.can-remove;
                                    tip: PrismeScenes.remove-tip;
                                    clicked => {
                                        PrismeScenes.remove();
                                    }
                                }
                            }
                        }
                    }
                    // Aperçu en direct.
                    VerticalLayout {
                        padding-top: 6px;
                        padding-bottom: 10px;
                        Rectangle {
                            height: 220px;
                            border-width: 1px;
                            border-color: PrismeTheme.line;
                            border-radius: PrismeTheme.radius-m;
                            background: PrismeTheme.panel;
                            clip: true;
                            CanvasView {
                                x: 1px;
                                y: 1px;
                                width: parent.width - 2px;
                                height: parent.height - 2px;
                            }
                        }
                    }
                    PRow {
                        label: "Effet";
                        value: "";
                        PSelect {
                            text: PrismeScenes.effect;
                            open(x, y) => {
                                PrismeScenes.pick-effect(x, y);
                            }
                        }
                    }
                    for p in PrismeScenes.params: ParamRow {
                        p: p;
                        set-number(k, v) => {
                            PrismeScenes.set-number(k, v);
                        }
                        set-bool(k, v) => {
                            PrismeScenes.set-bool(k, v);
                        }
                        pick-color(k, i) => {
                            PrismeScenes.pick-color(k, i);
                        }
                        pick-option(k, x, y) => {
                            PrismeScenes.pick-option(k, x, y);
                        }
                        toggle-option(k, o, v) => {
                            PrismeScenes.toggle-option(k, o, v);
                        }
                        add-color(k) => {
                            PrismeScenes.add-color(k);
                        }
                        remove-color(k, i) => {
                            PrismeScenes.remove-color(k, i);
                        }
                    }
                }
            }
        }
    }
}
