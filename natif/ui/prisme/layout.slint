// Page « Disposition » (apps/prisme/pages/Layout.svelte, lib/PlanEditor.svelte,
// lib/DeviceSettings.svelte) : à gauche les appareils (un seul ouvert à la fois : nom, état,
// clignotement, pilotage, zones et segments, forme de l'élément choisi, connexion et couleurs),
// l'ajout d'appareils ; à droite le plan du bureau à glisser. Tout s'applique et s'enregistre
// seul. Données : global `PrismeLayout` (src/prisme_window/layout.rs).

import { PrismeTheme } from "theme.slint";
import { PText, PButton, PField, PSelect, PRange, PCheck, PDot, PSummary, PHint, PScroll } from "controls.slint";
import { CanvasView } from "canvas.slint";

export struct PrismeDevice {
    id: string,
    title: string,
    // Pastille : 0 éteinte, 1 connecté, 2 en erreur.
    dot: int,
    disabled: bool,
    open: bool,
}

export struct PrismeZone {
    label: string,
    count: string,
    active: bool,
    zone: int,
    // Segment de la zone ; -1 : la zone elle-même.
    segment: int,
}

export struct PrismeFound {
    description: string,
    done: bool,
}

export global PrismeLayout {
    in property <bool> ready;
    in property <string> error;
    // Écran choisi sur le plan.
    in property <bool> screen-shown;
    in property <string> screen-title;
    in property <bool> screen-primary;
    in property <bool> screen-can-reset;
    in property <[PrismeDevice]> devices;
    // Appareil ouvert.
    in property <string> name;
    in property <string> placeholder;
    in property <string> state-text;
    in property <bool> state-error;
    in property <bool> connected;
    in property <string> blink-text;
    in property <bool> enabled;
    in property <[PrismeZone]> zones;
    // Élément choisi (de l'appareil ouvert) : forme, repérage, segments.
    in property <bool> sel-shown;
    in property <string> shape;
    in property <string> locate-text;
    // 0 : segment choisi, 1 : LED restantes après les segments, 2 : zone à découper, 3 : rien.
    in property <int> sel-mode;
    in property <string> seg-name;
    in property <string> seg-leds;
    in property <string> used-text;
    in property <bool> used-error;
    in property <bool> can-forward;
    in property <bool> can-back;
    // Réglages de l'appareil ouvert.
    in property <string> driver;
    in property <bool> conn-open;
    in property <bool> colors-open;
    in property <string> channels;
    in property <bool> mainboard;
    in property <string> port;
    in property <string> leds;
    in property <string> baud;
    in property <string> protocol;
    in property <string> host;
    in property <float> brightness;
    in property <[float]> white;
    in property <string> transfer;
    in property <bool> gamma-shown;
    in property <string> gamma;
    in property <string> limit;
    in property <bool> limit-custom;
    in property <string> amps;
    in property <bool> dither;
    // Ajout d'appareils.
    in property <bool> searching;
    in property <bool> has-found;
    in property <[PrismeFound]> found;

    callback reset-screen();
    callback toggle-device(string);
    callback rename(string);
    callback identify(int, int);
    callback set-enabled(bool);
    callback select-zone(int, int);
    callback set-shape(string);
    callback reverse();
    callback seg-name-edited(string);
    callback seg-leds-edited(string);
    callback seg-leds-step(int);
    callback move-segment(int);
    callback add-segment();
    callback remove-segment();
    callback split();
    callback remove-device();
    callback toggle-conn();
    callback toggle-colors();
    // Champ de connexion ou de couleur : channels, port, leds, baud, host, gamma, amps.
    callback set-text(string, string);
    callback step-text(string, int);
    // mainboard, dither.
    callback set-check(string, bool);
    // protocol, transfer, limit.
    callback pick(string, length, length);
    // brightness, w0, w1, w2.
    callback set-number(string, float);
    callback discover();
    callback add-found(int);

    // `toFixed(2)`.
    public pure function fixed2(v: float) -> string {
        let c = Math.round(v * 100);
        Math.floor(c / 100) + "." + (Math.mod(c, 100) < 10 ? "0" : "") + Math.mod(c, 100)
    }
}

component Small inherits PButton {
    kind: 2;
    font-size: PrismeTheme.fs-13;
    pad-x: 8px;
    pad-y: 4px;
}

// Ligne de la grille des réglages d'un appareil (110 px | reste).
component Cell inherits Rectangle {
    in property <string> label;
    min-height: row.min-height;
    preferred-height: row.preferred-height;
    row := HorizontalLayout {
        spacing: 10px;
        PText {
            width: 110px;
            text: root.label;
            color: PrismeTheme.muted;
            font-size: PrismeTheme.fs-13;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            @children
        }
    }
}

component Slider inherits Cell {
    in property <float> value;
    in property <float> maximum: 1;
    in property <string> shown;
    in property <string> key;
    HorizontalLayout {
        spacing: 8px;
        PRange {
            value: root.value;
            minimum: 0;
            maximum: root.maximum;
            step: 0.01;
            moved(v) => {
                PrismeLayout.set-number(root.key, v);
            }
        }
        PText {
            width: 48px;
            text: root.shown;
            color: PrismeTheme.muted;
            font-size: PrismeTheme.fs-small;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component TextCell inherits Cell {
    in property <string> key;
    in property <string> value;
    in property <bool> numeric;
    // Saisie appliquée à chaque frappe (`bind:value`) ou à la sortie du champ (`onchange`).
    in property <bool> live: true;
    PField {
        value: root.value;
        numeric: root.numeric;
        follow: root.live && !root.numeric;
        edited(t) => {
            if root.live {
                PrismeLayout.set-text(root.key, t);
            }
        }
        committed(t) => {
            PrismeLayout.set-text(root.key, t);
        }
        step(d) => {
            PrismeLayout.step-text(root.key, d);
        }
    }
}

// Titre d'une section repliable des réglages d'un appareil (`details` : filet au-dessus).
component Details inherits Rectangle {
    in property <string> title;
    in property <bool> open;
    callback toggled();
    height: summary.preferred-height + 12px;
    Rectangle {
        y: 0;
        height: 1px;
        background: PrismeTheme.line;
    }
    summary := PSummary {
        x: 0;
        y: 8px;
        width: self.preferred-width;
        text: root.title;
        open: root.open;
        toggled => {
            root.toggled();
        }
    }
}

// Contenu ouvert d'une section repliable.
component Section inherits Rectangle {
    min-height: col.min-height;
    preferred-height: col.preferred-height;
    col := VerticalLayout {
        padding-top: 8px;
        padding-bottom: 4px;
        spacing: 8px;
        @children
    }
}

// Réglages d'un appareil : connexion et rendu des couleurs (DeviceSettings.svelte).
component DeviceSettings inherits Rectangle {
    min-height: col.min-height;
    preferred-height: col.preferred-height;
    col := VerticalLayout {
    if PrismeLayout.driver != "logitech" && PrismeLayout.driver != "mountain_everest_max": Details {
        title: "Connexion";
        open: PrismeLayout.conn-open;
        toggled => {
            PrismeLayout.toggle-conn();
        }
    }
    if PrismeLayout.conn-open && PrismeLayout.driver != "logitech" && PrismeLayout.driver != "mountain_everest_max": Section {
        if PrismeLayout.driver == "asus_aura": TextCell {
            label: "LED par canal";
            key: "channels";
            value: PrismeLayout.channels;
            live: false;
        }
        if PrismeLayout.driver == "asus_aura": Cell {
            label: "LED de la carte mère";
            HorizontalLayout {
                alignment: start;
                PCheck {
                    checked: PrismeLayout.mainboard;
                    toggled(v) => {
                        PrismeLayout.set-check("mainboard", v);
                    }
                }
            }
        }
        if PrismeLayout.driver == "serial": TextCell {
            label: "Port";
            key: "port";
            value: PrismeLayout.port;
        }
        if PrismeLayout.driver == "serial" || PrismeLayout.driver == "ddp": TextCell {
            label: "Nombre de LED";
            key: "leds";
            value: PrismeLayout.leds;
            numeric: true;
        }
        if PrismeLayout.driver == "serial": TextCell {
            label: "Débit (bauds)";
            key: "baud";
            value: PrismeLayout.baud;
            numeric: true;
        }
        if PrismeLayout.driver == "serial": Cell {
            label: "Protocole";
            PSelect {
                text: PrismeLayout.protocol;
                open(x, y) => {
                    PrismeLayout.pick("protocol", x, y);
                }
            }
        }
        if PrismeLayout.driver == "ddp" || PrismeLayout.driver == "yeelight": TextCell {
            label: "Adresse";
            key: "host";
            value: PrismeLayout.host;
        }
    }
    Details {
        title: "Couleurs";
        open: PrismeLayout.colors-open;
        toggled => {
            PrismeLayout.toggle-colors();
        }
    }
    if PrismeLayout.colors-open: Section {
        Slider {
            label: "Luminosité";
            key: "brightness";
            value: PrismeLayout.brightness;
            shown: round(PrismeLayout.brightness * 100) + " %";
        }
        Slider {
            label: "Rouge";
            key: "w0";
            maximum: 1.5;
            value: PrismeLayout.white[0];
            shown: PrismeLayout.fixed2(PrismeLayout.white[0]);
        }
        Slider {
            label: "Vert";
            key: "w1";
            maximum: 1.5;
            value: PrismeLayout.white[1];
            shown: PrismeLayout.fixed2(PrismeLayout.white[1]);
        }
        Slider {
            label: "Bleu";
            key: "w2";
            maximum: 1.5;
            value: PrismeLayout.white[2];
            shown: PrismeLayout.fixed2(PrismeLayout.white[2]);
        }
        Cell {
            label: "Courbe";
            PSelect {
                text: PrismeLayout.transfer;
                open(x, y) => {
                    PrismeLayout.pick("transfer", x, y);
                }
            }
        }
        if PrismeLayout.gamma-shown: TextCell {
            label: "Gamma";
            key: "gamma";
            value: PrismeLayout.gamma;
            numeric: true;
        }
        Cell {
            label: "Limite de courant";
            PSelect {
                text: PrismeLayout.limit;
                open(x, y) => {
                    PrismeLayout.pick("limit", x, y);
                }
            }
        }
        if PrismeLayout.limit-custom: TextCell {
            label: "Ampères par zone";
            key: "amps";
            value: PrismeLayout.amps;
            numeric: true;
            live: false;
        }
        Cell {
            label: "Lisser les fondus sombres";
            HorizontalLayout {
                alignment: start;
                PCheck {
                    checked: PrismeLayout.dither;
                    toggled(v) => {
                        PrismeLayout.set-check("dither", v);
                    }
                }
            }
        }
        PHint {
            text: "Limite par zone (canal). Si le blanc ou le violet virent au rouge au bout d'une bande, l'alimentation ne suit plus : baisse la limite. Une bande avec sa propre alimentation peut s'en passer.";
        }
        PHint {
            text: "Rouge, vert et bleu corrigent la teinte du blanc. Le lissage efface les paliers des fondus très sombres, mais l'appareil reçoit alors une image à chaque fois.";
        }
    }
    }
}

// Élément choisi : forme, sens, repérage, segments.
component Selection inherits Rectangle {
    background: PrismeTheme.bg;
    border-radius: PrismeTheme.radius-s;
    min-height: col.min-height;
    preferred-height: col.preferred-height;
    col := VerticalLayout {
        padding: 10px;
        spacing: 8px;
        Rectangle {
            background: PrismeTheme.panel;
            border-radius: PrismeTheme.radius-s;
            height: shapes.preferred-height;
            shapes := HorizontalLayout {
                padding: 2px;
                spacing: 2px;
                for s in [{ key: "line", label: "Bande" }, { key: "point", label: "Point" }, { key: "rect", label: "Surface" }]: PButton {
                    kind: 3;
                    text: s.label;
                    pad-y: 4px;
                    pad-x: 0px;
                    horizontal-stretch: 1;
                    fg: PrismeLayout.shape == s.key ? PrismeTheme.text : PrismeTheme.muted;
                    hover-fg: self.fg;
                    flat-bg: PrismeLayout.shape == s.key ? PrismeTheme.live-soft : transparent;
                    clicked => {
                        PrismeLayout.set-shape(s.key);
                    }
                }
            }
        }
        FlexboxLayout {
            spacing-horizontal: 10px;
            spacing-vertical: 4px;
            if PrismeLayout.shape == "line": Small {
                text: "Inverser le sens";
                tip: "La première LED passe à l'autre bout";
                clicked => {
                    PrismeLayout.reverse();
                }
            }
            Small {
                text: PrismeLayout.locate-text;
                enabled: PrismeLayout.connected;
                clicked => {
                    PrismeLayout.identify(-2, -2);
                }
            }
        }
        if PrismeLayout.sel-mode == 0: VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                PField {
                    value: PrismeLayout.seg-name;
                    follow: true;
                    placeholder: "Nom du segment";
                    edited(t) => {
                        PrismeLayout.seg-name-edited(t);
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    PField {
                        width: 64px;
                        horizontal-stretch: 0;
                        value: PrismeLayout.seg-leds;
                        numeric: true;
                        edited(t) => {
                            PrismeLayout.seg-leds-edited(t);
                        }
                        step(d) => {
                            PrismeLayout.seg-leds-step(d);
                        }
                    }
                    PText {
                        text: "LED";
                        color: PrismeTheme.muted;
                        vertical-alignment: center;
                    }
                }
            }
            PHint {
                width: 243px;
                text: PrismeLayout.used-text;
                color: PrismeLayout.used-error ? PrismeTheme.danger : PrismeTheme.faint;
            }
            FlexboxLayout {
                spacing-horizontal: 10px;
                spacing-vertical: 4px;
                Small {
                    text: "Avancer";
                    tip: "Plus près du connecteur";
                    enabled: PrismeLayout.can-forward;
                    clicked => {
                        PrismeLayout.move-segment(-1);
                    }
                }
                Small {
                    text: "Reculer";
                    tip: "Plus loin du connecteur";
                    enabled: PrismeLayout.can-back;
                    clicked => {
                        PrismeLayout.move-segment(1);
                    }
                }
            }
            FlexboxLayout {
                spacing-horizontal: 10px;
                spacing-vertical: 4px;
                Small {
                    text: "Ajouter un segment";
                    clicked => {
                        PrismeLayout.add-segment();
                    }
                }
                Small {
                    text: "Retirer ce segment";
                    clicked => {
                        PrismeLayout.remove-segment();
                    }
                }
            }
            PHint {
                width: 243px;
                text: "Le premier segment est celui branché sur le connecteur. Vérifie avec « Repérer ».";
            }
        }
        if PrismeLayout.sel-mode == 1: VerticalLayout {
            spacing: 8px;
            PHint {
                width: 243px;
                text: "LED restantes après les segments.";
            }
            HorizontalLayout {
                alignment: start;
                Small {
                    text: "Ajouter un segment";
                    clicked => {
                        PrismeLayout.add-segment();
                    }
                }
            }
        }
        if PrismeLayout.sel-mode == 2: HorizontalLayout {
            alignment: start;
            Small {
                text: "Découper en segments";
                tip: "Plusieurs éléments branchés à la suite sur ce canal";
                clicked => {
                    PrismeLayout.split();
                }
            }
        }
    }
}

// Contenu d'un appareil ouvert.
component DeviceBody inherits Rectangle {
    min-height: col.min-height;
    preferred-height: col.preferred-height;
    col := VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-bottom: 10px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            PText {
                text: "Nom";
                color: PrismeTheme.muted;
                vertical-alignment: center;
            }
            PField {
                value: PrismeLayout.name;
                placeholder: PrismeLayout.placeholder;
                committed(t) => {
                    PrismeLayout.rename(t);
                }
            }
        }
        PText {
            text: PrismeLayout.state-text;
            color: PrismeLayout.state-error ? PrismeTheme.danger : PrismeTheme.muted;
            font-size: PrismeTheme.fs-13;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: 10px;
            PButton {
                text: PrismeLayout.blink-text;
                enabled: PrismeLayout.connected;
                clicked => {
                    PrismeLayout.identify(-1, -1);
                }
            }
            PCheck {
                text: "Piloter";
                checked: PrismeLayout.enabled;
                toggled(v) => {
                    PrismeLayout.set-enabled(v);
                }
            }
        }
        VerticalLayout {
            spacing: 2px;
            for z in PrismeLayout.zones: PButton {
                kind: 3;
                text: "";
                height: 28px;
                horizontal-stretch: 1;
                flat-bg: z.active ? PrismeTheme.live-soft : transparent;
                HorizontalLayout {
                    padding-left: z.segment >= 0 ? 23px : 9px;
                    padding-right: 9px;
                    spacing: 8px;
                    PText {
                        text: z.label;
                        font-size: PrismeTheme.fs-13;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    PText {
                        text: z.count;
                        color: PrismeTheme.faint;
                        font-size: PrismeTheme.fs-13;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                }
                if z.active: Rectangle {
                    x: 0;
                    width: 2px;
                    background: PrismeTheme.live;
                }
                clicked => {
                    PrismeLayout.select-zone(z.zone, z.segment);
                }
            }
        }
        if PrismeLayout.sel-shown: Selection { }
        DeviceSettings { }
        HorizontalLayout {
            alignment: start;
            PButton {
                kind: 2;
                text: "Retirer l'appareil";
                fg: PrismeTheme.danger;
                clicked => {
                    PrismeLayout.remove-device();
                }
            }
        }
    }
}

export component LayoutPage inherits Rectangle {
    if PrismeLayout.ready: HorizontalLayout {
        Rectangle {
            width: 320px;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: PrismeTheme.line;
            }
            PScroll {
                width: parent.width - 1px;
                content-height: aside.preferred-height;
                aside := VerticalLayout {
                    width: parent.width;
                    min-height: root.height;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 14px;
                    VerticalLayout {
                        spacing: 6px;
                        PText {
                            text: "Disposition";
                            font-size: 24px;
                            font-weight: 600;
                        }
                        PText {
                            text: "Glisse les appareils et les écrans pour les placer comme sur ton bureau. Tout s'enregistre tout seul.";
                            color: PrismeTheme.muted;
                            wrap: word-wrap;
                        }
                    }
                    if PrismeLayout.error != "": PText {
                        text: PrismeLayout.error;
                        color: PrismeTheme.danger;
                        wrap: word-wrap;
                    }
                    if PrismeLayout.screen-shown: Rectangle {
                        background: PrismeTheme.bg;
                        border-radius: PrismeTheme.radius-s;
                        min-height: sc.min-height;
                        preferred-height: sc.preferred-height;
                        sc := VerticalLayout {
                            padding: 10px;
                            spacing: 8px;
                            PText {
                                text: PrismeLayout.screen-title;
                                font-size: PrismeTheme.h3;
                                font-weight: 600;
                            }
                            PText {
                                text: PrismeLayout.screen-primary ? "L'écran principal sert de repère : déplace les autres autour de lui." : "Glisse-le sur le plan, ou ajuste avec les flèches du clavier.";
                                color: PrismeTheme.muted;
                                wrap: word-wrap;
                            }
                            if PrismeLayout.screen-can-reset: HorizontalLayout {
                                alignment: start;
                                PButton {
                                    text: "Revenir à la position de Windows";
                                    clicked => {
                                        PrismeLayout.reset-screen();
                                    }
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 2px;
                        for d in PrismeLayout.devices: Rectangle {
                            border-radius: PrismeTheme.radius-m;
                            background: d.open ? PrismeTheme.panel : transparent;
                            border-width: d.open ? 1px : 0px;
                            border-color: PrismeTheme.line;
                            min-height: dl.min-height;
                            preferred-height: dl.preferred-height;
                            dl := VerticalLayout {
                                PButton {
                                    kind: 3;
                                    text: "";
                                    height: 36px;
                                    horizontal-stretch: 1;
                                    border-radius: PrismeTheme.radius-m;
                                    HorizontalLayout {
                                        padding-left: 11px;
                                        padding-right: 11px;
                                        spacing: 9px;
                                        VerticalLayout {
                                            alignment: center;
                                            PDot {
                                                state: d.dot;
                                            }
                                        }
                                        PText {
                                            text: d.title;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if d.disabled: PText {
                                            text: "désactivé";
                                            color: PrismeTheme.faint;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    clicked => {
                                        PrismeLayout.toggle-device(d.id);
                                    }
                                }
                                if d.open: DeviceBody { }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: start;
                            PButton {
                                text: PrismeLayout.searching ? "Recherche…" : "Ajouter un appareil";
                                enabled: !PrismeLayout.searching;
                                clicked => {
                                    PrismeLayout.discover();
                                }
                            }
                        }
                        if PrismeLayout.has-found && PrismeLayout.found.length == 0: PHint {
                            text: "Aucun appareil trouvé. Vérifie qu'il est branché, ou que son contrôle réseau est activé.";
                        }
                        for f[i] in PrismeLayout.found: HorizontalLayout {
                            spacing: 8px;
                            PText {
                                text: f.description;
                                font-size: PrismeTheme.fs-13;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                            VerticalLayout {
                                alignment: center;
                                PButton {
                                    kind: 2;
                                    text: f.done ? "Déjà là" : "Ajouter";
                                    enabled: !f.done;
                                    clicked => {
                                        PrismeLayout.add-found(i);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-top: 16px;
            padding-bottom: 12px;
            padding-left: 20px;
            padding-right: 20px;
            CanvasView {
                editor: true;
                vertical-stretch: 1;
                min-height: 300px;
                label: "Plan du bureau : glisse les appareils et les écrans. Flèches pour un déplacement fin.";
            }
            PHint {
                text: "Glisser pour déplacer · extrémités pour étirer · Alt pour ne pas aimanter · flèches pour ajuster · Échap pour désélectionner";
                horizontal-alignment: center;
                height: self.preferred-height + 8px;
                vertical-alignment: bottom;
            }
        }
    }
}
