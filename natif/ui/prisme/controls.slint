// Contrôles de l'interface de Prisme, au design de app/src/apps/prisme/app.css (boutons, champs,
// listes déroulantes, curseurs, cases, pastilles, sections repliables, défilement). Propres à
// cette fenêtre : Prisme a son propre design (fond neutre, couleur des LED `live`), distinct de
// celui des panneaux d'Horizon (ui/panel/).
//
// Focus : comme un navigateur, un clic sur un bouton lui donne le focus ; l'anneau
// (`:focus-visible`, 2 px dans `live` à 2 px de l'élément) n'apparaît qu'au clavier (Tab), sauf
// pour un champ de texte (dès qu'il a le focus).

import { PrismeTheme } from "theme.slint";
import { Tip } from "../tooltip.slint";

// Texte au style de la page.
export component PText inherits Text {
    color: PrismeTheme.text;
    font-family: PrismeTheme.font;
    font-size: PrismeTheme.fs;
}

// Anneau du focus clavier. L'élément donne sa taille : `width: root.width + 8px;
// height: root.height + 8px;`.
export component PRing inherits Rectangle {
    in property <length> radius;
    x: -4px;
    y: -4px;
    border-radius: root.radius + 4px;
    border-width: 2px;
    border-color: PrismeTheme.live;
}

// Bouton (`button`, `button.primary`, `button.quiet` d'app.css). `tip` : attribut `title`.
// Désactivé : estompé, sans clic, mais son info-bulle reste.
export component PButton inherits Rectangle {
    in property <string> text;
    // 0 : normal, 1 : principal, 2 : discret, 3 : à plat (élément de liste, onglet : ni fond ni
    // bord au survol ; `flat-bg`, `flat-border`).
    in property <int> kind: 0;
    in property <color> flat-bg: transparent;
    in property <color> flat-border: transparent;
    in property <bool> enabled: true;
    in property <string> tip;
    in property <length> font-size: PrismeTheme.fs;
    in property <int> font-weight: 400;
    in property <length> pad-x: 14px;
    in property <length> pad-y: 6px;
    in property <color> fg: root.kind == 2 ? PrismeTheme.muted : PrismeTheme.text;
    in property <color> hover-fg: PrismeTheme.text;
    in property <TextHorizontalAlignment> align: center;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    property <bool> keyboard;
    property <bool> hot: ta.has-hover && root.enabled;
    property <color> rest: root.kind == 1 ? PrismeTheme.primary-bg : root.kind == 2 ? transparent : root.kind == 3 ? root.flat-bg : PrismeTheme.raised;
    min-width: 2 * root.pad-x + 2px;
    preferred-width: label.preferred-width + 2 * root.pad-x + 2px;
    height: label.preferred-height + 2 * root.pad-y + 2px;
    horizontal-stretch: 0;
    border-width: 1px;
    border-radius: PrismeTheme.radius-s;
    border-color: root.kind == 1 ? PrismeTheme.primary-border : root.kind == 2 ? transparent : root.kind == 3 ? root.flat-border : PrismeTheme.line;
    background: root.hot && root.kind != 3 ? (root.kind == 2 ? PrismeTheme.raised : PrismeTheme.raised-hover) : root.rest;
    opacity: root.enabled ? 1 : 0.45;
    animate background { duration: PrismeTheme.transition; }

    label := Text {
        x: root.pad-x + 1px;
        width: root.width - 2 * root.pad-x - 2px;
        height: root.height;
        text: root.text;
        color: root.hot ? root.hover-fg : root.fg;
        font-family: PrismeTheme.font;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: root.align;
        vertical-alignment: center;
        overflow: elide;
    }
    @children
    fs := FocusScope {
        enabled: root.enabled;
        focus-gained(r) => {
            root.keyboard = r == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard = false;
        }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        changed has-hover => {
            if self.has-hover {
                Tip.show(root.tip);
            } else {
                Tip.hide();
            }
        }
        clicked => {
            Tip.hide();
            if root.enabled {
                fs.focus();
                root.keyboard = false;
                root.clicked();
            }
        }
    }
    if root.keyboard && fs.has-focus: PRing {
        width: root.width + 8px;
        height: root.height + 8px;
        radius: root.border-radius;
    }
}

// Champ de saisie (`input[type=text|number]`). `value` vient du brouillon ; ce qui est tapé
// part par `edited` (à chaque frappe, `bind:value`) et `committed` (Entrée ou sortie du champ,
// événement `change`). Le champ ne reprend `value` que s'il n'a pas le focus (une saisie en
// cours n'est jamais écrasée). `numeric` : ↑ / ↓ annoncent `step(±1)`.
export component PField inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <int> font-weight: 400;
    // Nom d'une règle : sans fond ni bord tant qu'on ne le survole ni ne le modifie.
    in property <bool> bare;
    in property <bool> numeric;
    in property <bool> invalid;
    // Le champ suit `value` même pendant la saisie (`bind:value` : la valeur est ce qui vient
    // d'être tapé ; une remise à zéro après « Créer » se voit).
    in property <bool> follow;
    in property <bool> mono;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback committed(string);
    // Entrée seulement (envoi d'un formulaire).
    callback accepted(string);
    callback step(int);
    property <bool> open: !root.bare || ta.has-hover || input.has-focus;
    property <length> pad: root.open ? 10px : 0px;
    height: 32px;
    min-width: 40px;
    horizontal-stretch: 1;
    border-width: 1px;
    border-radius: PrismeTheme.radius-s;
    border-color: root.invalid ? PrismeTheme.danger : root.open ? PrismeTheme.line : transparent;
    background: root.bare ? transparent : PrismeTheme.bg;
    opacity: root.enabled ? 1 : 0.45;

    ta := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }
    Rectangle {
        x: root.pad;
        width: root.width - 2 * root.pad;
        clip: true;
        if input.text == "": Text {
            width: parent.width;
            height: parent.height;
            text: root.placeholder;
            color: PrismeTheme.faint;
            font-family: PrismeTheme.font;
            font-size: PrismeTheme.fs;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            width: max(parent.width, self.preferred-width);
            height: parent.height;
            enabled: root.enabled;
            color: PrismeTheme.text;
            font-family: root.mono ? PrismeTheme.font-mono : PrismeTheme.font;
            font-size: PrismeTheme.fs;
            font-weight: root.font-weight;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: PrismeTheme.live.with-alpha(0.35);
            selection-foreground-color: PrismeTheme.text;
            init => {
                self.text = root.value;
            }
            edited => {
                root.edited(self.text);
            }
            accepted => {
                root.accepted(self.text);
                root.committed(self.text);
            }
            changed has-focus => {
                if !self.has-focus {
                    root.committed(self.text);
                    self.x = 0;
                }
            }
            key-pressed(e) => {
                if root.numeric && e.text == Key.UpArrow {
                    root.step(1);
                    return accept;
                }
                if root.numeric && e.text == Key.DownArrow {
                    root.step(-1);
                    return accept;
                }
                reject
            }
            cursor-position-changed(p) => {
                if p.x + self.x < 0 {
                    self.x = -p.x;
                } else if p.x + self.x > parent.width - 2px {
                    self.x = parent.width - p.x - 2px;
                }
            }
        }
    }
    changed value => {
        if root.follow || !input.has-focus {
            input.text = root.value;
        }
    }
    if input.has-focus: PRing {
        width: root.width + 8px;
        height: root.height + 8px;
        radius: root.border-radius;
    }
}

// Liste déroulante (`select`) : la valeur choisie et un chevron ; un clic (ou Entrée, Espace,
// Alt+↓) annonce `open(x, y)` (coin bas-gauche, coordonnées de la fenêtre) : Rust ouvre la liste
// des choix (menu Windows) à cet endroit.
export component PSelect inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <string> tip;
    callback open(length, length);
    property <bool> keyboard;
    height: 32px;
    min-width: 60px;
    preferred-width: label.preferred-width + 46px;
    border-width: 1px;
    border-radius: PrismeTheme.radius-s;
    border-color: ta.has-hover && root.enabled ? PrismeTheme.muted : PrismeTheme.line;
    background: PrismeTheme.bg;
    opacity: root.enabled ? 1 : 0.45;

    function go() {
        Tip.hide();
        root.open(root.absolute-position.x, root.absolute-position.y + root.height);
    }
    label := Text {
        x: 10px;
        width: root.width - 36px;
        height: root.height;
        text: root.text;
        color: PrismeTheme.text;
        font-family: PrismeTheme.font;
        font-size: PrismeTheme.fs;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: root.width - 24px;
        y: (root.height - self.height) / 2;
        width: 12px;
        height: 12px;
        source: @image-url("../../icons/phosphor/caretDown.svg");
        colorize: PrismeTheme.muted;
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-gained(r) => {
            root.keyboard = r == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard = false;
        }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " || (e.modifiers.alt && e.text == Key.DownArrow) {
                root.go();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        changed has-hover => {
            if self.has-hover {
                Tip.show(root.tip);
            } else {
                Tip.hide();
            }
        }
        clicked => {
            fs.focus();
            root.keyboard = false;
            root.go();
        }
    }
    if root.keyboard && fs.has-focus: PRing {
        width: root.width + 8px;
        height: root.height + 8px;
        radius: root.border-radius;
    }
}

// Curseur (`input[type=range]` avec `accent-color: var(--live)`), contrôlé : il affiche `value`
// et annonce `moved` à chaque pas, `released` à la fin du geste. Souris, clavier (flèches,
// Pg préc./suiv., Début, Fin). `hue` : piste en dégradé des teintes, bouton clair.
export component PRange inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <bool> enabled: true;
    in property <bool> hue;
    out property <bool> dragging: area.pressed;
    callback moved(float);
    callback released(float);
    property <length> knob: 16px;
    property <float> frac: root.maximum > root.minimum ? clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1) : 0;
    property <float> last: root.value;
    property <bool> keyboard;
    min-width: 60px;
    height: 20px;
    horizontal-stretch: 1;
    opacity: root.enabled ? 1 : 0.45;

    function snap(v: float) -> float {
        clamp(round((v - root.minimum) / root.step) * root.step + root.minimum, root.minimum, root.maximum)
    }
    function at(x: length) -> float {
        root.snap(root.minimum + clamp((x - root.knob / 2) / max(1px, root.width - root.knob), 0, 1) * (root.maximum - root.minimum))
    }
    function go(v: float) {
        if v != root.last {
            root.last = v;
            root.moved(v);
        }
    }

    if !root.hue: Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: PrismeTheme.track;
        Rectangle {
            x: 0;
            width: root.knob / 2 + root.frac * (parent.width - root.knob);
            border-radius: 2px;
            background: PrismeTheme.live;
        }
    }
    // Teintes OKLCH (0,72 ; 0,17) tous les 30°, interpolées comme le dégradé du navigateur.
    if root.hue: Rectangle {
        y: (parent.height - self.height) / 2;
        height: 8px;
        border-radius: 4px;
        background: @linear-gradient(90deg, #f771a0 0%, #fd7562 8.33%, #ef8600 16.67%, #ce9d00 25%, #98b305 33.33%, #3fc168 41.67%, #00c5a9 50%, #00bfdf 58.33%, #00afff 66.67%, #7c9cff 75%, #b688fe 83.33%, #de79d7 91.67%, #f771a0 100%);
    }
    Rectangle {
        x: root.frac * (root.width - root.knob);
        y: (parent.height - self.height) / 2;
        width: root.knob;
        height: root.knob;
        border-radius: root.knob / 2;
        background: root.hue ? PrismeTheme.text : PrismeTheme.live;
        border-width: root.hue ? 2px : 0;
        border-color: PrismeTheme.bg;
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-gained(r) => {
            root.keyboard = r == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard = false;
        }
        key-pressed(e) => {
            if e.text == Key.LeftArrow || e.text == Key.DownArrow {
                root.go(root.snap(root.value - root.step));
            } else if e.text == Key.RightArrow || e.text == Key.UpArrow {
                root.go(root.snap(root.value + root.step));
            } else if e.text == Key.PageDown {
                root.go(root.snap(root.value - 10 * root.step));
            } else if e.text == Key.PageUp {
                root.go(root.snap(root.value + 10 * root.step));
            } else if e.text == Key.Home {
                root.go(root.minimum);
            } else if e.text == Key.End {
                root.go(root.maximum);
            } else {
                return reject;
            }
            accept
        }
        key-released(e) => {
            if e.text == Key.LeftArrow || e.text == Key.DownArrow || e.text == Key.RightArrow || e.text == Key.UpArrow
                || e.text == Key.PageDown || e.text == Key.PageUp || e.text == Key.Home || e.text == Key.End {
                root.released(root.last);
                return accept;
            }
            reject
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                fs.focus();
                root.keyboard = false;
                root.last = root.value;
                root.go(root.at(self.mouse-x));
            } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                root.released(root.last);
            }
        }
        moved => {
            if self.pressed {
                root.go(root.at(self.mouse-x));
            }
        }
    }
    if root.keyboard && fs.has-focus: PRing {
        width: root.width + 8px;
        height: root.height + 8px;
        radius: 10px;
    }
}

// Case à cocher (`input[type=checkbox]`, 16 px, `accent-color: var(--live)`), avec son libellé
// éventuel (toute la ligne se clique, comme un `<label>`). Contrôlée : `toggled(nouvelle valeur)`.
export component PCheck inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> fg: PrismeTheme.text;
    callback toggled(bool);
    property <bool> keyboard;
    min-width: row.min-width;
    preferred-width: row.preferred-width;
    height: max(20px, row.preferred-height);
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.45;

    fs := FocusScope {
        enabled: root.enabled;
        focus-gained(r) => {
            root.keyboard = r == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard = false;
        }
        key-pressed(e) => {
            if e.text == " " {
                root.toggled(!root.checked);
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            fs.focus();
            root.keyboard = false;
            root.toggled(!root.checked);
        }
    }
    row := HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            box := Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 3px;
                border-width: root.checked ? 0 : 1px;
                border-color: ta.has-hover ? PrismeTheme.text : PrismeTheme.check-border;
                background: root.checked ? (ta.has-hover ? PrismeTheme.live.brighter(0.1) : PrismeTheme.live) : PrismeTheme.check-bg;
                if root.checked: Image {
                    x: 2px;
                    y: 2px;
                    width: 12px;
                    height: 12px;
                    source: @image-url("../../icons/phosphor/check.svg");
                    colorize: PrismeTheme.bg;
                }
                if root.keyboard && fs.has-focus: PRing {
                    width: parent.width + 8px;
                    height: parent.height + 8px;
                    radius: 3px;
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-family: PrismeTheme.font;
            font-size: PrismeTheme.fs;
            vertical-alignment: center;
        }
    }
}

// Pastille d'état (`.dot`, `.dot.on`, `.dot.err`) : 0 éteinte, 1 active (verte, halo), 2 en
// erreur (rouge).
export component PDot inherits Rectangle {
    in property <int> state;
    width: 8px;
    height: 8px;
    if root.state == 1: Rectangle {
        x: -4px;
        y: -4px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: PrismeTheme.ok.with-alpha(0.22);
    }
    Rectangle {
        border-radius: 4px;
        background: root.state == 1 ? PrismeTheme.ok : root.state == 2 ? PrismeTheme.danger : PrismeTheme.faint;
    }
}

// Pastille de couleur (`input[type=color]`, 44 × 28) : un clic annonce `pick` (sélecteur de
// couleurs de Windows, comme le navigateur).
export component PColor inherits Rectangle {
    in property <color> swatch;
    in property <string> tip;
    callback pick();
    property <bool> keyboard;
    width: 44px;
    height: 28px;
    border-width: 1px;
    border-radius: PrismeTheme.radius-s;
    border-color: ta.has-hover ? PrismeTheme.muted : PrismeTheme.line;
    background: PrismeTheme.bg;
    Rectangle {
        x: 5px;
        y: 5px;
        width: parent.width - 10px;
        height: parent.height - 10px;
        border-radius: 2px;
        background: root.swatch;
    }
    fs := FocusScope {
        focus-gained(r) => {
            root.keyboard = r == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard = false;
        }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                root.pick();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        changed has-hover => {
            if self.has-hover {
                Tip.show(root.tip);
            } else {
                Tip.hide();
            }
        }
        clicked => {
            Tip.hide();
            fs.focus();
            root.keyboard = false;
            root.pick();
        }
    }
    if root.keyboard && fs.has-focus: PRing {
        width: root.width + 8px;
        height: root.height + 8px;
        radius: root.border-radius;
    }
}

// Titre d'une section repliable (`<summary>` de `<details>`) : marqueur et texte estompé, plus
// clair au survol.
export component PSummary inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    in property <length> font-size: PrismeTheme.fs;
    callback toggled();
    property <bool> keyboard;
    height: label.preferred-height + 4px;
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Image {
                width: 10px;
                height: 10px;
                source: root.open ? @image-url("../../icons/phosphor/caretDownFill.svg") : @image-url("../../icons/phosphor/caretRightFill.svg");
                colorize: ta.has-hover ? PrismeTheme.text : PrismeTheme.muted;
            }
        }
        label := Text {
            text: root.text;
            color: ta.has-hover ? PrismeTheme.text : PrismeTheme.muted;
            font-family: PrismeTheme.font;
            font-size: root.font-size;
            vertical-alignment: center;
        }
    }
    fs := FocusScope {
        focus-gained(r) => {
            root.keyboard = r == FocusReason.tab-navigation;
        }
        focus-lost => {
            root.keyboard = false;
        }
        key-pressed(e) => {
            if e.text == Key.Return || e.text == " " {
                root.toggled();
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            fs.focus();
            root.keyboard = false;
            root.toggled();
        }
    }
    if root.keyboard && fs.has-focus: PRing {
        width: root.width + 8px;
        height: root.height + 8px;
        radius: 2px;
    }
}

// Zone qui défile verticalement (`overflow: auto`) : molette, barre fine à droite (glissable).
export component PScroll inherits Rectangle {
    in property <length> content-height;
    in-out property <length> offset;
    property <length> max-offset: max(0px, root.content-height - root.height);
    property <float> ratio: root.content-height > 0 ? min(1, root.height / root.content-height) : 1;
    property <length> drag-from;
    property <length> drag-offset;
    clip: true;
    flick := Flickable {
        width: root.width;
        height: root.height;
        content-width: root.width;
        content-height: max(root.height, root.content-height);
        content-y <=> root.offset;
        interactive: false;
        @children
    }
    if root.max-offset > 0: Rectangle {
        x: root.width - 9px;
        width: 9px;
        bar-ta := TouchArea {
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.drag-from = self.mouse-y;
                    root.drag-offset = -root.offset;
                }
            }
            moved => {
                if self.pressed {
                    root.offset = -clamp(root.drag-offset + (self.mouse-y - root.drag-from) / root.ratio, 0px, root.max-offset);
                }
            }
        }
        Rectangle {
            x: 2px;
            width: bar-ta.has-hover || bar-ta.pressed ? 6px : 4px;
            y: (-root.offset) * root.ratio + 2px;
            height: max(24px, root.height * root.ratio - 4px);
            border-radius: 3px;
            background: bar-ta.pressed ? PrismeTheme.muted : PrismeTheme.faint.with-alpha(0.7);
        }
    }
}

// Ligne de réglage (`.field` d'app.css : libellé de 190 px, contrôle, valeur de 104 px à droite).
export component PRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> label-color: PrismeTheme.text;
    in property <length> label-width: 190px;
    in property <length> value-width: 104px;
    // Pastille ronde à la place de la valeur (teinte).
    in property <bool> has-swatch;
    in property <color> swatch;
    min-height: max(34px, row.min-height);
    preferred-height: max(34px, row.preferred-height);
    row := HorizontalLayout {
        spacing: 12px;
        PText {
            width: root.label-width;
            text: root.label;
            color: root.label-color;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: stretch;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                @children
            }
        }
        if root.has-swatch: HorizontalLayout {
            width: root.value-width;
            alignment: end;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: PrismeTheme.line;
                    background: root.swatch;
                }
            }
        }
        if root.value-width > 0 && !root.has-swatch: PText {
            width: root.value-width;
            text: root.value;
            color: PrismeTheme.muted;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Aide sous un réglage (`.hint`).
export component PHint inherits Text {
    color: PrismeTheme.faint;
    font-family: PrismeTheme.font;
    font-size: PrismeTheme.fs-small;
    wrap: word-wrap;
}
