// Page « Lumière » (apps/prisme/pages/Now.svelte) : ce qui s'affiche, pourquoi, et les réglages
// du quotidien (mode, luminosité, appareils). Données : global `PrismeNow` (src/prisme_window/now.rs).

import { PrismeTheme } from "theme.slint";
import { PText, PButton, PRange, PDot } from "controls.slint";
import { CanvasView } from "canvas.slint";
import { Tip } from "../tooltip.slint";

export struct PrismeMode {
    key: string,
    label: string,
    on: bool,
}

export struct PrismeChip {
    name: string,
    tip: string,
    // Pastille : 0 éteinte, 1 connecté, 2 en erreur.
    state: int,
}

export global PrismeNow {
    in property <string> title;
    in property <string> reason;
    in property <string> error;
    in property <[PrismeMode]> modes;
    in property <float> brightness;
    in property <[PrismeChip]> devices;
    // « 2 sur 3 connectés » (vide : aucun appareil piloté).
    in property <string> summary;
    // Mode choisi : une scène, ou "" pour « Auto ».
    callback choose(string);
    callback brightness-moved(float);
}

export component NowPage inherits Rectangle {
    VerticalLayout {
        padding-top: 28px;
        padding-left: 32px;
        padding-right: 32px;
        padding-bottom: 22px;
        spacing: 10px;

        VerticalLayout {
            spacing: 6px;
            FlexboxLayout {
                alignment: space-between;
                cross-axis-alignment: end;
                spacing: 24px;
                VerticalLayout {
                    spacing: 4px;
                    PText {
                        text: PrismeNow.title;
                        font-size: 40px;
                        font-weight: 600;
                    }
                    PText {
                        text: PrismeNow.reason;
                        color: PrismeTheme.muted;
                    }
                }
                Rectangle {
                    background: PrismeTheme.panel;
                    border-width: 1px;
                    border-color: PrismeTheme.line;
                    border-radius: PrismeTheme.radius-m;
                    accessible-role: list;
                    accessible-label: "Mode d'éclairage";
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 2px;
                        for m in PrismeNow.modes: PButton {
                            kind: 3;
                            text: m.label;
                            fg: m.on ? PrismeTheme.text : PrismeTheme.muted;
                            hover-fg: self.fg;
                            flat-bg: m.on ? PrismeTheme.live-soft : transparent;
                            flat-border: m.on ? PrismeTheme.live.with-alpha(0.45) : transparent;
                            border-radius: 7px;
                            clicked => {
                                PrismeNow.choose(m.key);
                            }
                        }
                    }
                }
            }
            if PrismeNow.error != "": PText {
                text: PrismeNow.error;
                color: PrismeTheme.danger;
                wrap: word-wrap;
            }
        }

        CanvasView {
            vertical-stretch: 1;
        }

        FlexboxLayout {
            alignment: space-between;
            cross-axis-alignment: center;
            spacing: 32px;
            HorizontalLayout {
                spacing: 14px;
                PText {
                    text: "Luminosité";
                    vertical-alignment: center;
                }
                PRange {
                    width: 260px;
                    value: PrismeNow.brightness;
                    minimum: 0;
                    maximum: 1;
                    step: 0.01;
                    moved(v) => {
                        PrismeNow.brightness-moved(v);
                    }
                }
                PText {
                    width: 48px;
                    text: round(PrismeNow.brightness * 100) + " %";
                    color: PrismeTheme.muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            FlexboxLayout {
                spacing-horizontal: 18px;
                spacing-vertical: 6px;
                cross-axis-alignment: center;
                for d in PrismeNow.devices: Rectangle {
                    width: chip.preferred-width;
                    height: chip.preferred-height;
                    chip := HorizontalLayout {
                        spacing: 7px;
                        VerticalLayout {
                            alignment: center;
                            PDot {
                                state: d.state;
                            }
                        }
                        PText {
                            text: d.name;
                            font-size: PrismeTheme.fs-13;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        changed has-hover => {
                            if self.has-hover {
                                Tip.show(d.tip);
                            } else {
                                Tip.hide();
                            }
                        }
                    }
                }
                if PrismeNow.summary != "": PText {
                    text: PrismeNow.summary;
                    color: PrismeTheme.muted;
                    font-size: PrismeTheme.fs-13;
                }
            }
        }
    }
}
