// Un réglage d'effet selon son type (apps/prisme/lib/ParamControl.svelte) : curseur et valeur,
// teinte et pastille, case, couleur, liste déroulante, cases multiples, palette.

import { PrismeTheme } from "theme.slint";
import { PText, PButton, PRange, PCheck, PColor, PSelect, PRow, PHint } from "controls.slint";

export struct PrismeOption {
    key: string,
    label: string,
    on: bool,
}

export struct PrismeParam {
    key: string,
    label: string,
    // range, hue, bool, color, select, multi, palette
    kind: string,
    value: float,
    minimum: float,
    maximum: float,
    step: float,
    // Valeur affichée (curseur), choix (liste), `#rrggbb` (couleur).
    text: string,
    checked: bool,
    // Couleur (couleur), pastille (teinte).
    color: color,
    options: [PrismeOption],
    palette: [color],
    hint: string,
}

export component ParamRow inherits Rectangle {
    in property <PrismeParam> p;
    callback set-number(string, float);
    callback set-bool(string, bool);
    // Index dans la palette, -1 : le réglage « couleur ».
    callback pick-color(string, int);
    callback pick-option(string, length, length);
    callback toggle-option(string, string, bool);
    callback add-color(string);
    callback remove-color(string, int);
    min-height: col.min-height;
    preferred-height: col.preferred-height;

    col := VerticalLayout {
    PRow {
        label: root.p.label;
        has-swatch: root.p.kind == "hue";
        swatch: root.p.color;
        value: root.p.kind == "range" || root.p.kind == "color" ? root.p.text : "";
        if root.p.kind == "range": PRange {
            value: root.p.value;
            minimum: root.p.minimum;
            maximum: root.p.maximum;
            step: root.p.step;
            moved(v) => {
                root.set-number(root.p.key, v);
            }
        }
        if root.p.kind == "hue": PRange {
            hue: true;
            value: root.p.value;
            minimum: 0;
            maximum: 1;
            step: 0.005;
            moved(v) => {
                root.set-number(root.p.key, v);
            }
        }
        if root.p.kind == "bool": HorizontalLayout {
            alignment: start;
            PCheck {
                checked: root.p.checked;
                toggled(v) => {
                    root.set-bool(root.p.key, v);
                }
            }
        }
        if root.p.kind == "color": HorizontalLayout {
            alignment: start;
            PColor {
                swatch: root.p.color;
                pick => {
                    root.pick-color(root.p.key, -1);
                }
            }
        }
        if root.p.kind == "select": PSelect {
            text: root.p.text;
            open(x, y) => {
                root.pick-option(root.p.key, x, y);
            }
        }
        if root.p.kind == "multi": FlexboxLayout {
            spacing-horizontal: 14px;
            spacing-vertical: 4px;
            for o in root.p.options: PCheck {
                text: o.label;
                checked: o.on;
                toggled(v) => {
                    root.toggle-option(root.p.key, o.key, v);
                }
            }
        }
        if root.p.kind == "palette": FlexboxLayout {
            spacing: 6px;
            cross-axis-alignment: center;
            for c[i] in root.p.palette: HorizontalLayout {
                PColor {
                    swatch: c;
                    tip: "Couleur " + (i + 1);
                    pick => {
                        root.pick-color(root.p.key, i);
                    }
                }
                PButton {
                    kind: 2;
                    text: "×";
                    pad-x: 6px;
                    pad-y: 2px;
                    tip: "Retirer la couleur " + (i + 1);
                    clicked => {
                        root.remove-color(root.p.key, i);
                    }
                }
            }
            PButton {
                kind: 2;
                text: "Ajouter une couleur";
                clicked => {
                    root.add-color(root.p.key);
                }
            }
        }
    }
    if root.p.hint != "": HorizontalLayout {
        padding-left: 202px;
        padding-bottom: 6px;
        PHint {
            text: root.p.hint;
        }
    }
}
}
